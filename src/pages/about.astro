---
import BaseLayout from "../layouts/BaseLayout.astro";
import AIStrategySection from "../components/AIStrategySection.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import ToolKit from "../components/ToolKit.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import julianPortrait from "../assets/about/current/julian-about-climbing.png";
---

<BaseLayout
  title="About | Julian Galindo"
  description="About Julian Galindo, a Staff Product Designer connecting customer experience, product systems, front-end development, automation, and design leadership."
>
  <header class="about-intro">
    <div class="container intro-layout">
      <div class="intro-copy">
        <p class="eyebrow">About</p>
        <p class="current-title">Staff Product Designer</p>
        <h1>Designer by foundation. Builder through experience.</h1>
        <p class="intro-lead">I’m an observer extrovert who loves creating, whether it’s building with my hands or on a computer. I care about serving my community, soaking up live music, and finding joy in simple moments.</p>
        <ul class="intro-facts" aria-label="A few personal facts about Julian">
          <li>35+ concerts, from Carrie Underwood to Metallica.</li>
          <li>My wife surprised me with a 4,000-foot climb and rappel. I hate heights.</li>
          <li>My daughter drew the doodle in my logo when she was four.</li>
          <li>My high school sweetheart and I spent a year living in Medellín, Colombia.</li>
        </ul>
        <div class="principle" aria-label="Portfolio principle">
          <span>Portfolio principle</span>
          <strong>Simple. Scalable. Memorable.</strong>
        </div>
      </div>
      <div class="intro-portrait">
        <img src={julianPortrait.src} alt="Julian Galindo smiling while rappelling on a mountain" />
      </div>
    </div>
  </header>

  <section class="page-section career-section" aria-labelledby="career-heading">
    <div class="container">
      <header class="section-heading">
        <div>
          <p class="eyebrow">Career Evolution</p>
          <h2 id="career-heading">The title changed. The goal stayed the same.</h2>
        </div>
        <p>Since 2008, each role has given me another way to solve the same kind of problem: make an experience clearer, improve the work behind it, and help people move forward with less friction.</p>
      </header>
      <CareerTimeline />
    </div>
  </section>

  <section class="page-section thinking-section" aria-labelledby="thinking-heading">
    <div class="container">
      <header class="thinking-heading">
        <p class="eyebrow">How I Think</p>
        <h2 id="thinking-heading">“I wish this could be easier.”</h2>
        <p>That question often starts my best work. The answer might be a better interface, an internal tool, automation, a redesigned workflow, or removing the task entirely.</p>
      </header>
      <WorkflowVisual />
    </div>
  </section>

  <section class="page-section leadership-section" aria-labelledby="leadership-heading">
    <div class="container leadership-layout">
      <header>
        <p class="eyebrow">Leading While Staying Hands-On</p>
        <p class="team-number" aria-label="Team of four">04</p>
        <h2 id="leadership-heading">A multidisciplinary interactive design team.</h2>
      </header>
      <div class="leadership-copy">
        <p class="lead">I lead a multidisciplinary interactive design team while staying close to work that benefits from prototyping, design, debugging, or building. I also improve workflows and create internal products that help the team work better together.</p>
        <ul aria-label="Team and leadership areas">
          <li>UX / UI</li>
          <li>Graphic design</li>
          <li>Front-end</li>
          <li>Email development</li>
          <li>Experimentation</li>
          <li>Automation</li>
        </ul>
      </div>
    </div>
  </section>

  <AIStrategySection headingId="about-ai-strategy-heading" />

  <ToolKit />

  <section id="contact" class="personal-section" aria-label="Contact Julian">
    <div class="container">
      <div class="contact-card">
        <p class="eyebrow">Let’s Talk</p>
        <h2>I like complicated problems that should probably be easier.</h2>
        <div class="actions">
          <a class="button-link contact-email" href="mailto:juliangalindo11@gmail.com">Email Me</a>
          <a
            class="contact-linkedin"
            href="https://www.linkedin.com/in/julian-galindo-designs/"
            target="_blank"
            rel="noreferrer"
            aria-label="Connect with Julian on LinkedIn"
          >LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro {
    padding-block: var(--space-7) var(--space-9);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.7fr);
    align-items: center;
    gap: var(--space-8);
  }

  .current-title {
    margin: var(--space-6) 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .intro-copy h1 {
    max-width: 13ch;
    margin-bottom: var(--space-6);
    font-size: clamp(3.25rem, 5.5vw, 4.5rem);
  }

  .intro-copy > p:not(.eyebrow, .current-title) {
    color: var(--color-text-soft);
  }

  .intro-lead {
    font-size: var(--step-1);
  }

  .intro-facts {
    display: grid;
    margin: var(--space-5) 0 0;
    padding: 0 0 0 1.15rem;
    color: var(--color-text-soft);
    gap: var(--space-3);
  }

  .intro-facts li {
    padding-left: var(--space-2);
    line-height: 1.55;
  }

  .intro-facts li::marker {
    color: var(--color-accent);
  }

  .principle {
    display: flex;
    max-width: 38rem;
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    justify-content: space-between;
    border-top: 1px solid var(--color-border-strong);
    gap: var(--space-4);
  }

  .principle span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .principle strong {
    color: var(--color-accent);
  }

  .intro-portrait {
    display: grid;
    justify-items: center;
    padding: 0;
    background: transparent;
  }

  .intro-portrait img {
    display: block;
    width: min(100%, 29rem);
    height: auto;
    object-fit: contain;
  }

  .career-section,
  .leadership-section {
    background: var(--color-canvas);
  }

  .thinking-section {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .thinking-heading {
    max-width: 52rem;
    margin-bottom: var(--space-7);
  }

  .thinking-heading h2 {
    margin-block: var(--space-3) var(--space-4);
    font-size: clamp(2.1rem, 3.5vw, 2.8rem);
  }

  .thinking-heading > p:last-child {
    color: var(--color-text-soft);
    font-size: var(--step-1);
  }

  .leadership-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-9);
  }

  .team-number {
    margin: var(--space-6) 0 var(--space-4);
    color: var(--color-accent);
    font-size: var(--step-5);
    font-weight: 750;
    letter-spacing: -0.07em;
    line-height: 0.8;
  }

  .leadership-layout h2 {
    max-width: 15ch;
  }

  .leadership-copy .lead {
    margin-top: 0;
    font-size: var(--step-1);
  }

  .leadership-copy ul {
    display: flex;
    margin: var(--space-7) 0 0;
    padding: var(--space-5) 0 0;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border-strong);
    gap: var(--space-2);
    list-style: none;
  }

  .leadership-copy li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .personal-section {
    padding-block: var(--space-8);
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: clamp(var(--space-6), 6vw, var(--space-9));
    align-items: end;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .contact-card h2 {
    grid-column: 1;
    max-width: 19ch;
    font-size: var(--step-3);
  }

  .contact-card > .eyebrow { grid-column: 1 / -1; }

  .contact-card .contact-email { border-color: var(--color-text); background: transparent; color: var(--color-text); }
  .contact-card .contact-email:hover { background: var(--color-text); color: var(--color-surface); }
  .contact-linkedin { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: var(--space-2); color: var(--color-text); font-weight: 700; gap: var(--space-2); text-decoration: none; }
  .contact-linkedin:hover { text-decoration: underline; text-underline-offset: 0.25rem; }
  .contact-linkedin:focus-visible { border-radius: var(--radius-sm); outline: 3px solid var(--color-focus); outline-offset: 3px; }

  .actions {
    display: flex;
    grid-column: 2;
    grid-row: 2;
    margin-top: 0;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 58rem) {
    .intro-layout,
    .leadership-layout {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .intro-layout {
      min-height: auto;
    }

    .intro-portrait {
      justify-self: stretch;
    }
  }

  @media (max-width: 48rem) {
    .about-intro {
      padding-block: var(--space-6) var(--space-8);
    }

    .intro-copy h1 {
      font-size: clamp(2.6rem, 10vw, 3.25rem);
    }

    .intro-lead,
    .thinking-heading > p:last-child,
    .leadership-copy .lead {
      font-size: var(--step-0);
    }

    .principle {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    .thinking-heading h2,
    .contact-card h2 {
      font-size: var(--step-2);
    }

    .team-number {
      font-size: var(--step-4);
    }

    .personal-section {
      padding-block: clamp(4rem, 12vw, 4.5rem);
    }

    .contact-card {
      padding: var(--space-5);
      grid-template-columns: 1fr;
    }

    .actions { grid-column: 1; grid-row: auto; margin-top: var(--space-5); }
  }
</style>
