---
import BaseLayout from "../layouts/BaseLayout.astro";
import AIStrategySection from "../components/AIStrategySection.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import ToolKit from "../components/ToolKit.astro";
import julianPortrait from "../assets/about/current/julian-about-climbing.png";
---

<BaseLayout
  title="About | Julian Galindo"
  description="About Julian Galindo, a Staff Product Designer connecting customer experience, product systems, front-end development, automation, and design leadership."
>
  <header class="about-intro">
    <div class="container intro-layout">
      <div class="intro-copy">
        <p class="eyebrow">Wanna know a little more about me?</p>
        <h1>The guy behind the work</h1>
        <div class="intro-lead">
          <p>I’m the kind of person who notices how people interact with things, how they use them, and why certain things work the way they do.</p>
          <p>For me, it all comes back to paying attention to people and trying to make things a little better. A lot of my ideas start with the same thought: <strong>“I wish this was easier.”</strong></p>
        </div>
        <div class="facts-panel">
          <p class="facts-subtitle">A few facts about me</p>
          <ul class="intro-facts" aria-label="A few personal facts about Julian">
            <li>I’ve been to 35+ concerts, from Carrie Underwood to Metallica.</li>
            <li>My wife once surprised me with a 4,000-foot climb and rappel. I hate heights.</li>
            <li>My daughter drew the doodle in my logo when she was four.</li>
            <li>My wife (high school sweetheart) and I spent a year living in Medellín, Colombia before moving to Austin.</li>
          </ul>
        </div>
      </div>
      <div class="intro-portrait">
        <img src={julianPortrait.src} alt="Julian Galindo smiling while rappelling on a mountain" />
      </div>
    </div>
  </header>

  <section class="page-section career-section" aria-labelledby="career-heading">
    <div class="container">
      <header class="section-heading">
        <div>
          <p class="eyebrow">Career Evolution</p>
          <h2 id="career-heading">The title changed. The goal stayed the same.</h2>
        </div>
        <p>Since 2008, each role has given me another way to solve the same kind of problem: make an experience clearer, improve the work behind it, and help people move forward with less friction.</p>
      </header>
      <CareerTimeline />
    </div>
  </section>

  <section class="page-section leadership-section" aria-labelledby="leadership-heading">
    <div class="container leadership-layout">
      <header>
        <p class="eyebrow">Leading a Team of Four</p>
        <h2 id="leadership-heading">Different skills, one connected team.</h2>
      </header>
      <div class="leadership-copy">
        <p class="lead">At Callaway Brands, I lead a team of four: a front-end specialist who supports interactive experiences and A/B testing, an email developer, a UX/UI designer, and a graphic designer. Each person brings a different strength. Because I have worked across all four areas, I can give useful direction while giving each person room to own their craft.</p>
        <ul aria-label="Team specialties">
          <li><span>01</span><strong>Front-end and experimentation</strong></li>
          <li><span>02</span><strong>Email development</strong></li>
          <li><span>03</span><strong>UX and UI design</strong></li>
          <li><span>04</span><strong>Graphic design</strong></li>
        </ul>
      </div>
    </div>
  </section>

  <AIStrategySection headingId="about-ai-strategy-heading" tone="canvas" />

  <ToolKit tone="surface" />

  <section id="contact" class="personal-section" aria-label="Contact Julian">
    <div class="container">
      <div class="contact-card">
        <div>
          <p class="eyebrow">Enough About Me</p>
          <h2>If you made it this far, something must have caught your eye. Let’s connect.</h2>
        </div>
        <div class="actions">
          <a class="button-link contact-email" href="mailto:juliangalindo11@gmail.com">Email me <span aria-hidden="true">↗</span></a>
          <a
            class="button-link secondary contact-linkedin"
            href="https://www.linkedin.com/in/julian-galindo-designs/"
            target="_blank"
            rel="noreferrer"
            aria-label="Connect with Julian on LinkedIn"
          >LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro {
    padding-block: var(--space-7) var(--space-9);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
    align-items: center;
    column-gap: var(--space-9);
    row-gap: var(--space-7);
  }

  .intro-copy h1 {
    max-width: 15ch;
    margin: var(--space-6) 0 var(--space-5);
    font-size: clamp(2.15rem, 3.2vw, 3rem);
    line-height: 1.06;
  }

  .intro-lead {
    max-width: 40rem;
    color: var(--color-text-soft);
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.6;
  }

  .intro-lead p { margin: 0; }
  .intro-lead p + p { margin-top: var(--space-3); }
  .intro-lead strong { color: var(--color-accent); font-weight: 800; }

  .facts-panel {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
  }

  .facts-subtitle {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .intro-facts {
    display: grid;
    grid-template-columns: 1fr;
    margin: var(--space-4) 0 0;
    padding: 0;
    color: var(--color-text-soft);
    font-size: 1rem;
    row-gap: 0;
    list-style: none;
  }

  .intro-facts li {
    position: relative;
    min-height: 0;
    padding: var(--space-2) 0 var(--space-2) 2rem;
    border: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .intro-facts li::before {
    position: absolute;
    top: 0.5rem;
    left: 0;
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    content: "✓";
    font-size: 0.72rem;
    font-weight: 800;
  }

  .intro-portrait {
    display: grid;
    justify-items: center;
    padding: 0;
    background: transparent;
  }

  .intro-portrait img {
    display: block;
    width: min(100%, 29rem);
    height: auto;
    object-fit: contain;
  }

  .career-section { background: var(--color-canvas); }
  .leadership-section { border-block: 1px solid var(--color-border); background: var(--color-surface); }

  .leadership-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-9);
  }

  .leadership-layout h2 {
    max-width: 15ch;
    margin-top: var(--space-3);
  }

  .leadership-copy .lead {
    margin-top: 0;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .leadership-copy ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .leadership-copy li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .leadership-copy li:nth-child(odd) { border-right: 1px solid var(--color-border); }
  .leadership-copy li:nth-child(even) { padding-left: var(--space-4); }
  .leadership-copy li span { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.65rem; }
  .leadership-copy li strong { font-size: var(--step--1); }

  .personal-section {
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
    background: var(--color-canvas);
  }

  .contact-card {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
    text-align: center;
  }

  .contact-card h2 {
    max-width: 31ch;
    margin: var(--space-3) auto 0;
    font-size: var(--step-2);
  }

  .actions .button-link { gap: var(--space-2); }
  .actions .button-link span { transition: transform var(--transition-fast); }
  .actions .button-link:hover span { transform: translate(0.15rem, -0.15rem); }

  .actions {
    display: flex;
    margin-top: 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @media (max-width: 58rem) {
    .intro-layout,
    .leadership-layout {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .intro-layout {
      min-height: auto;
      row-gap: var(--space-6);
    }

    .intro-portrait {
      justify-self: stretch;
    }

  }

  @media (max-width: 48rem) {
    .about-intro {
      padding-block: var(--space-6) var(--space-8);
    }

    .intro-copy h1 {
      font-size: clamp(2rem, 8vw, 2.5rem);
    }

    .intro-lead,
    .leadership-copy .lead {
      font-size: 1rem;
    }

    .intro-facts { grid-template-columns: 1fr; }

    .contact-card h2 {
      font-size: var(--step-2);
    }

    .personal-section {
      padding-block: clamp(4rem, 12vw, 4.5rem);
    }

    .leadership-copy ul { grid-template-columns: 1fr; }
    .leadership-copy li:nth-child(odd) { border-right: 0; }
    .leadership-copy li:nth-child(even) { padding-left: 0; }
    .actions { width: 100%; margin-top: var(--space-2); }
    .actions .button-link { flex: 1 1 9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .actions .button-link span { transition: none; }
  }
</style>
