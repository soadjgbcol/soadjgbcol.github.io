---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkIndexGroup from "../../components/WorkIndexGroup.astro";
import SelectedBuildsList from "../../components/SelectedBuildsList.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(projects.map((project) => [project.id, project]));
const internalPrimary = byId["teebox"];
const internalRelated = ["merchandising-operations", "campaign-builder", "business-trend-monitor"].map((id) => byId[id]);
const customerPrimary = byId["caddy"];
const customerRelated = ["club-finder", "trade-in-trade-up"].map((id) => byId[id]);
---

<BaseLayout title="Work | Julian Galindo" description="Selected internal products, systems, and customer experiences by Julian Galindo.">
  <header class="work-intro container">
    <div>
      <p class="eyebrow">Work</p>
      <h1>Products, systems, and customer experiences designed to remove friction and create measurable impact.</h1>
    </div>
    <div class="positioning" aria-label="Current positioning">
      <p>Staff AI Product Designer</p>
      <span>Simple. Scalable. Accessible.</span>
    </div>
  </header>

  <div class="container flagship-work">
    <WorkIndexGroup
      label="Internal Products & Systems"
      description="Tools and operating systems that help teams create, plan, monitor, and deliver better work."
      primary={internalPrimary}
      related={internalRelated}
    />

    <WorkIndexGroup
      label="Customer Experiences"
      description="Shopping experiences that make complex choices clearer, faster, and easier to act on."
      primary={customerPrimary}
      related={customerRelated}
    />
  </div>

  <section class="supporting-section leadership-section" aria-labelledby="leadership-heading">
    <div class="container supporting-layout">
      <header>
        <p class="eyebrow">Current Leadership</p>
        <h2 id="leadership-heading">Improving the web experience across brands.</h2>
      </header>
      <div>
        <p class="supporting-lead">Current scope spans brand redesigns, reusable experience patterns, and cross-brand UX leadership while staying close to delivery.</p>
        <ul class="scope-list">
          <li><span>01</span>OGIO redesign</li>
          <li><span>02</span>CGPO redesign</li>
          <li><span>03</span>Homepage and web experience evolution</li>
          <li><span>04</span>Reusable components</li>
          <li><span>05</span>Cross-brand UX leadership</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="supporting-section builds-section" aria-labelledby="builds-heading">
    <div class="container supporting-layout">
      <header>
        <p class="eyebrow">Selected Builds</p>
        <h2 id="builds-heading">Small tools. Recurring problems removed.</h2>
      </header>
      <SelectedBuildsList />
    </div>
  </section>

  <section class="work-cta" aria-labelledby="work-cta-heading">
    <div class="container">
      <p class="eyebrow">About the work behind the work</p>
      <h2 id="work-cta-heading">Looking for a designer who can connect product judgment with execution?</h2>
      <div class="actions">
        <a class="button-link" href="/about/">About Me</a>
        <a class="button-link secondary" href="/about/#contact">Contact Me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.5fr);
    min-height: clamp(28rem, 65vh, 32rem);
    align-items: end;
    padding-block: var(--space-8) var(--space-7);
    gap: var(--space-8);
  }

  .work-intro h1 {
    max-width: 20ch;
    margin-bottom: 0;
    font-size: clamp(3rem, 5vw, 4.25rem);
  }

  .positioning {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-strong);
  }

  .positioning p {
    margin: 0 0 var(--space-2);
    font-weight: 750;
  }

  .positioning span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .flagship-work {
    padding-bottom: var(--space-8);
  }

  .supporting-section {
    padding-block: var(--space-9);
    border-top: 1px solid var(--color-border);
  }

  .leadership-section {
    background: var(--color-surface);
  }

  .builds-section {
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-canvas));
  }

  .supporting-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-9);
  }

  .supporting-layout h2 {
    max-width: 16ch;
    font-size: var(--step-3);
  }

  .supporting-lead {
    margin-top: 0;
    color: var(--color-text-soft);
    font-size: var(--step-1);
  }

  .scope-list {
    margin: var(--space-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .scope-list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--step-1);
    font-weight: 650;
  }

  .scope-list span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .work-cta {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .work-cta h2 {
    max-width: 22ch;
    font-size: var(--step-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-7);
    gap: var(--space-3);
  }

  @media (max-width: 48rem) {
    .work-intro {
      grid-template-columns: 1fr;
      min-height: auto;
      align-items: start;
      padding-block: var(--space-8);
      gap: var(--space-6);
    }

    .work-intro h1 {
      font-size: var(--step-3);
    }

    .supporting-layout {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .supporting-layout h2 {
      font-size: var(--step-2);
    }

    .supporting-section {
      padding-block: var(--space-8);
    }

    .supporting-lead {
      font-size: var(--step-0);
    }

  }
</style>
