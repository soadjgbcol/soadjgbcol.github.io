---
import julianLogoBase from "../assets/legacy/JG Logobg.png";
import julianLogoOrbit from "../assets/legacy/JG Logo.png";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const links = [
  { href: "/", label: "Home", current: isHome },
  { href: isHome ? "#featured-work" : "/#featured-work", label: "Work", current: currentPath.startsWith("/work/") },
  { href: "/about/", label: "About", current: currentPath.startsWith("/about/") },
];
---

<header class:list={["site-header", { "home-header": isHome }]} data-home-header={isHome || undefined}>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Julian Galindo, home">
      <span class="brand-mark" aria-hidden="true">
        <img class="brand-base" src={julianLogoBase.src} width={julianLogoBase.width} height={julianLogoBase.height} alt="" />
        <img class="brand-orbit" src={julianLogoOrbit.src} width={julianLogoOrbit.width} height={julianLogoOrbit.height} alt="" />
      </span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

{isHome && (
  <script>
    const headerControllers = new WeakMap<HTMLElement, () => void>();

    function initializeHomeHeader() {
      document.querySelectorAll<HTMLElement>("[data-home-header]:not([data-header-ready])").forEach((header) => {
        header.dataset.headerReady = "true";
        const hero = document.querySelector<HTMLElement>(".hero");
        let frame = 0;

        const update = () => {
          frame = 0;
          if (!hero?.isConnected || !header.isConnected) return;
          const boundary = hero.getBoundingClientRect().bottom;
          header.classList.toggle("is-scrolled", boundary <= header.offsetHeight + 32);
        };

        const requestUpdate = () => {
          if (!frame) frame = requestAnimationFrame(update);
        };

        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate, { passive: true });
        window.addEventListener("load", requestUpdate, { once: true });
        update();
        requestAnimationFrame(() => requestAnimationFrame(update));

        headerControllers.set(header, () => {
          window.removeEventListener("scroll", requestUpdate);
          window.removeEventListener("resize", requestUpdate);
          window.removeEventListener("load", requestUpdate);
          if (frame) cancelAnimationFrame(frame);
          header.removeAttribute("data-header-ready");
        });
      });
    }

    initializeHomeHeader();
    document.addEventListener("astro:page-load", initializeHomeHeader);
    document.addEventListener("astro:before-swap", () => {
      document.querySelectorAll<HTMLElement>("[data-home-header]").forEach((header) => {
        headerControllers.get(header)?.();
        headerControllers.delete(header);
      });
    });
  </script>
)}

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    background: #ffffff61;
    backdrop-filter: blur(0.75rem);
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
  }

  .site-header.home-header {
    position: fixed;
    right: 0;
    left: 0;
    border-bottom-color: transparent;
    background: transparent;
    backdrop-filter: none;
  }

  .site-header.home-header:not(.is-scrolled) .brand,
  .site-header.home-header:not(.is-scrolled) nav a { color: #f2f1ec; }

  .site-header.home-header:not(.is-scrolled) .brand-mark img { filter: brightness(0) invert(1); }
  .site-header.home-header:not(.is-scrolled) nav a:hover { background: rgb(255 255 255 / 0.09); }
  .site-header.home-header:not(.is-scrolled) nav a[aria-current="page"] { background: rgb(255 255 255 / 0.12); }

  .site-header.home-header.is-scrolled {
    border-bottom-color: color-mix(in srgb, var(--color-border) 72%, transparent);
    background: #ffffff61;
    backdrop-filter: blur(0.75rem);
  }

  .header-inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    min-width: 3.75rem;
    min-height: 3.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    position: relative;
    width: 3.75rem;
    height: 3.75rem;
  }

  .brand-mark img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 220ms ease;
  }

  .brand-orbit { animation: brand-orbit 25s linear infinite; }

  @keyframes brand-orbit {
    to { transform: rotate(-360deg); }
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  nav a:hover { background: var(--color-surface-strong); }

  nav a[aria-current="page"] {
    background: var(--color-surface-raised);
    font-weight: 700;
  }

  @media (max-width: 32rem) {
    .brand, .brand-mark { width: 3.25rem; min-width: 3.25rem; height: 3.25rem; min-height: 3.25rem; }

    nav a {
      padding-inline: var(--space-2);
    }
  }

  @media (max-width: 22.5rem) {
    .header-inner { gap: var(--space-2); }
    ul { gap: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-orbit { animation: none; }
  }
</style>
