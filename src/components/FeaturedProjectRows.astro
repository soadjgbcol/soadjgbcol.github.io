---
import type { CollectionEntry } from "astro:content";
import teeboxImage from "../assets/home/project-covers/teebox-homepage-cover.png";
import teeboxLayerOne from "../assets/home/project-covers/teebox-cover-layer-1.png";
import teeboxLayerTwo from "../assets/home/project-covers/teebox-cover-layer-2.png";
import teeboxLayerThree from "../assets/home/project-covers/teebox-cover-layer-3.png";
import clubFinderImage from "../assets/home/project-covers/club-finder-homepage-cover.png";
import clubFinderLayerOne from "../assets/home/project-covers/club-finder-cover-layer-1.png";
import clubFinderLayerTwo from "../assets/home/project-covers/club-finder-cover-layer-2.png";
import clubFinderLayerThree from "../assets/home/project-covers/club-finder-cover-layer-3.png";
import preownedHomepageImage from "../assets/cgpo-homepage/preowned-homepage-hero.png";
import preownedLayerOne from "../assets/home/project-covers/preowned-cover-layer-1.png";
import preownedLayerTwo from "../assets/home/project-covers/preowned-cover-layer-2.png";
import preownedLayerThree from "../assets/home/project-covers/preowned-cover-layer-3.png";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const projectById = Object.fromEntries(projects.map((project) => [project.id, project]));
const layeredCovers = {
  teebox: [teeboxLayerOne, teeboxLayerTwo, teeboxLayerThree],
  "club-finder": [clubFinderLayerOne, clubFinderLayerTwo, clubFinderLayerThree],
  "preowned-homepage-redesign": [preownedLayerOne, preownedLayerTwo, preownedLayerThree],
};
const layeredCoverByProject = (projectId: string) => layeredCovers[projectId as keyof typeof layeredCovers] ?? null;

const presentations = [
  {
    id: "teebox",
    number: "01",
    disciplines: "Internal Product · Product Strategy · Workflow Transformation",
    image: teeboxImage,
    alt: "Split composition showing the Teebox email builder alongside a system diagram of templates, content blocks, reusable modules, quality checks, previews, and export workflow.",
    headline: "One system for email production.",
    cta: "Explore Teebox",
    description: "I designed and built a unified multi-brand email platform that brought creation, reusable content, quality checks, previews, and delivery into one system.",
    emphasis: "It removed repeated coding and troubleshooting, giving my team more time to design.",
    metrics: [
      { value: "4+ hrs", label: "Minimum saved per Callaway Golf email", state: "Validated" },
      { value: "5 → 1", label: "Workflow tools consolidated", state: "Estimated" },
    ],
  },
  {
    id: "club-finder",
    number: "02",
    disciplines: "Customer Experience · Guided Discovery · Experimentation",
    image: clubFinderImage,
    alt: "Split composition showing the refreshed Club Finder shopping interface alongside a system diagram of discovery paths, guided questions, filters, experimentation, and decision support.",
    headline: "Simplifying the path to the right club.",
    cta: "Explore Club Finder",
    description: "I led customer research, redesigned Club Finder, and built the live A/B test used to validate it with real customers. Clearer categories, filters, and product results made a complex buying decision easier.",
    metrics: [
      { value: "+16.20%", label: "Desktop add-to-cart conversion", state: "Validated" },
      { value: "+7.69%", label: "Desktop order conversion", state: "Validated" },
    ],
  },
  {
    id: "preowned-homepage-redesign",
    number: "03",
    disciplines: "Ecommerce UX · Information Architecture · Research",
    image: preownedHomepageImage,
    alt: "Callaway Pre-Owned homepage redesign shown across desktop and mobile screens.",
    headline: "A clearer marketplace homepage.",
    cta: "Explore Pre-Owned Redesign",
    description: "I led the Pre-Owned homepage redesign from research and content strategy through interface design, partial front-end implementation, launch, and measurement. The new structure made shopping paths easier to find while reducing the page height by 42.9%.",
    metrics: [
      { value: "-33.9%", label: "Bounce rate", state: "After launch" },
      { value: "+9.98%", label: "Time spent", state: "After launch" },
    ],
  },
].map((presentation) => ({ ...presentation, project: projectById[presentation.id] }));
---

<div class="featured-project-rows">
  {presentations.map(({ project, ...presentation }, index) => {
    const layeredCover = layeredCoverByProject(presentation.id);
    return project && (
      <article
        class:list={["featured-project-row", `layered-cover-${presentation.id}`, { "is-reversed": index % 2 === 1, "is-layered-project-row": layeredCover }]}
      >
        <a class:list={["featured-project-media", { "is-layered-cover": layeredCover }]} href={`/work/${project.id}/`} aria-label={`View ${project.data.publicName} case study`}>
          {layeredCover ? (
            <span class="layered-project-cover" aria-hidden="true">
              {layeredCover.map((layer, layerIndex) => (
                <img
                  class:list={["project-cover-layer", `project-cover-layer-${layerIndex + 1}`]}
                  src={layer.src}
                  width={layer.width}
                  height={layer.height}
                  alt=""
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              ))}
            </span>
          ) : (
            <img src={presentation.image.src} width={presentation.image.width} height={presentation.image.height} alt={presentation.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          )}
        </a>
      <div class="featured-project-copy">
        <p class="project-number">{presentation.number} / {project.data.publicName}</p>
        <p class="project-disciplines">{presentation.disciplines}</p>
        <h3><a href={`/work/${project.id}/`}>{presentation.headline}</a></h3>
        <p class="project-description">
          {presentation.description}
          {presentation.emphasis && <> <strong>{presentation.emphasis}</strong></>}
        </p>
        <div class="project-metrics" aria-label={`${project.data.publicName} impact`}>
          {presentation.metrics.map((metric) => (
            <div>
              <span>{metric.state}</span>
              <strong>{metric.value}</strong>
              <p>{metric.label}</p>
            </div>
          ))}
        </div>
        <a class="project-link" href={`/work/${project.id}/`}>{presentation.cta} <span aria-hidden="true">↗</span></a>
      </div>
      </article>
    );
  })}
</div>

<style>
  .featured-project-rows { display: grid; gap: 5rem; }
  .featured-project-row { display: grid; min-height: 30rem; grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr); border-bottom: 1px solid var(--color-border); }
  .featured-project-row.is-layered-project-row { border-bottom: 0; }
  .featured-project-row.is-reversed { grid-template-columns: minmax(20rem, 1.2fr) minmax(0, 0.8fr); }
  .is-reversed .featured-project-media { grid-column: 2; }
  .is-reversed .featured-project-copy { grid-row: 1; grid-column: 1; border-right: 1px solid var(--color-border); border-left: 0; }
  .featured-project-media { position: relative; display: grid; min-width: 0; max-height: min(43rem, 82vh); overflow: hidden; place-items: center; background: #e8ebe8; }
  .featured-project-media img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 420ms cubic-bezier(.22, 1, .36, 1); }
  .featured-project-media:not(.is-layered-cover):hover img,
  .featured-project-media:not(.is-layered-cover):focus-visible img { transform: scale(1.015); }
  .featured-project-media.is-layered-cover { perspective: 70rem; background: transparent; }
  .is-layered-project-row { --cover-tilt: 8deg; }
  .is-layered-project-row.is-reversed { --cover-tilt: -8deg; }
  .layered-project-cover { position: relative; display: block; width: 100%; height: 100%; min-height: 30rem; transform: rotateX(0) rotateY(0) translateY(0); transform-style: preserve-3d; transition: transform 680ms cubic-bezier(.16, 1, .3, 1); will-change: transform; }
  .is-layered-project-row:hover .layered-project-cover,
  .is-layered-project-row:focus-within .layered-project-cover { transform: rotateX(3deg) rotateY(var(--cover-tilt)) translateY(-0.3rem); }
  .layered-project-cover .project-cover-layer { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transform: translateZ(0); transition: transform 680ms cubic-bezier(.16, 1, .3, 1); will-change: transform; }
  .layered-project-cover .project-cover-layer-1 { z-index: 1; }
  .layered-project-cover .project-cover-layer-2 { z-index: 2; }
  .layered-project-cover .project-cover-layer-3 { z-index: 3; }
  .is-layered-project-row:hover .project-cover-layer-2,
  .is-layered-project-row:focus-within .project-cover-layer-2 { transform: translateZ(1rem); }
  .is-layered-project-row:hover .project-cover-layer-3,
  .is-layered-project-row:focus-within .project-cover-layer-3 { transform: translateZ(2rem); }
  .featured-project-media:focus-visible, .featured-project-copy a:focus-visible { z-index: 2; outline: 3px solid var(--color-focus); outline-offset: -3px; }
  .featured-project-copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: clamp(var(--space-5), 3vw, var(--space-7)); border-left: 1px solid var(--color-border); background: #fff; }
  .is-layered-project-row .featured-project-copy { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .project-number { margin: 0; color: var(--color-text); font: 700 0.72rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .project-disciplines { margin: var(--space-3) 0 0; color: var(--color-accent); font: 700 0.62rem var(--font-mono); letter-spacing: 0.07em; line-height: 1.5; text-transform: uppercase; }
  h3 { max-width: 20ch; margin: var(--space-4) 0 0; font-size: clamp(1.75rem, 2.6vw, 2.75rem); letter-spacing: -0.035em; line-height: 1.08; }
  h3 a { color: var(--color-text); text-decoration: none; }
  .project-description { max-width: 38rem; margin: var(--space-4) 0 0; color: var(--color-text-muted); font-size: clamp(0.94rem, 1.25vw, 1.05rem); line-height: 1.65; }
  .project-description strong { color: var(--color-text); font-weight: 750; }
  .project-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--space-4); border-block: 1px solid var(--color-border); }
  .project-metrics > div { display: grid; min-width: 0; grid-template-areas: "value state" "value label"; grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr); align-content: center; align-items: center; padding: var(--space-3) var(--space-4) var(--space-3) 0; column-gap: var(--space-3); }
  .project-metrics > div + div { padding-left: var(--space-4); border-left: 1px solid var(--color-border); }
  .project-metrics span { grid-area: state; align-self: end; color: var(--color-text-muted); font: 700 0.58rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .project-metrics strong { grid-area: value; margin: 0; color: var(--color-accent); font-size: clamp(1.55rem, 2.3vw, 2.35rem); font-variant-numeric: tabular-nums; letter-spacing: -0.045em; line-height: 1; white-space: nowrap; }
  .project-metrics p { grid-area: label; align-self: start; margin: 0.15rem 0 0; color: var(--color-text-muted); font-size: 0.7rem; font-weight: 700; line-height: 1.3; }
  .project-link { display: inline-flex; min-height: 2.75rem; align-self: flex-start; align-items: center; margin-top: var(--space-4); padding-block: 0.55rem; color: var(--color-accent); font-weight: 750; gap: var(--space-2); text-decoration: none; }
  .project-link span { transition: transform var(--transition-fast); }
  .project-link:hover span, .project-link:focus-visible span { transform: translate(0.15rem, -0.15rem); }
  @media (max-width: 64rem) {
    .featured-project-row, .featured-project-row.is-reversed { min-height: 0; grid-template-columns: 1fr; }
    .featured-project-media, .is-reversed .featured-project-media { grid-row: 1; grid-column: 1; max-height: min(32rem, 58vh); aspect-ratio: 5 / 3; }
    .featured-project-copy, .is-reversed .featured-project-copy { grid-row: 2; grid-column: 1; border-top: 1px solid var(--color-border); border-right: 0; border-left: 0; }
    .layered-project-cover { min-height: 0; }
  }
  @media (max-width: 34rem) {
    .featured-project-copy { padding: var(--space-5); }
    .project-metrics { grid-template-columns: 1fr; }
    .project-metrics > div { grid-template-columns: minmax(5.5rem, 0.55fr) minmax(0, 1.45fr); padding: var(--space-3) 0; }
    .project-metrics > div + div { padding-left: 0; border-top: 1px solid var(--color-border); border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-project-media img, .project-link span { transition: none; }
    .is-layered-project-row:hover .layered-project-cover,
    .is-layered-project-row:focus-within .layered-project-cover { transform: none; }
    .layered-project-cover,
    .layered-project-cover .project-cover-layer { transition: none; }
    .is-layered-project-row:hover .project-cover-layer,
    .is-layered-project-row:focus-within .project-cover-layer { transform: none; }
  }
</style>
