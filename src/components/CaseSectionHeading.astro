---
interface Props { number: string; eyebrow: string; title: string; }
const { number, eyebrow, title } = Astro.props;
---

<div class="section-title">
  <p class="section-number">{number}</p>
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>
</div>

<style>
  .section-title { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-3); margin-bottom: var(--space-6); }
  .section-title p, .section-title h2 { margin-bottom: 0; }
  .section-number { margin: 0; color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.7rem; }
  @media (max-width: 34rem) { .section-title { grid-template-columns: 2rem 1fr; } }
</style>
