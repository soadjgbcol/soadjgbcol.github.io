---
interface Props { number: string; eyebrow: string; title: string; }
const { number, eyebrow, title } = Astro.props;
---

<div class="section-title">
  <p class="section-number">{number}</p>
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>
</div>

<style>
  .section-title { position: relative; margin-bottom: var(--space-6); }
  .section-title p, .section-title h2 { margin-bottom: 0; }
  .section-number {
    position: absolute;
    top: 0.05em;
    right: calc(100% + var(--space-5));
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: clamp(3rem, 4.5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.82;
  }
  @media (max-width: 50rem) {
    .section-title { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); gap: var(--space-3); }
    .section-number { position: static; font-size: clamp(2.5rem, 10vw, 3.4rem); }
  }
  @media (max-width: 34rem) {
    .section-title { grid-template-columns: 3.4rem minmax(0, 1fr); gap: var(--space-2); }
    .section-number { font-size: 2.4rem; }
  }
</style>
