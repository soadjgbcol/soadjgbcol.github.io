---
import putterSelectorPreview from "../assets/legacy/selector.jpg";
import personalityQuizPreview from "../assets/legacy/quiz.jpg";
import customizerPreview from "../assets/legacy/Customizer.jpg";
import sampleCover from "../assets/home/project-covers/sample.png";
import microFace from "../assets/playground/putter/Micro.png";
import milledFace from "../assets/playground/putter/Milled.png";
import traditionalAlignment from "../assets/playground/putter/TraditionalA.png";
import advancedAlignment from "../assets/playground/putter/TT.png";
import cloudGraphic from "../assets/playground/putter/lg-cloud.png";
import cartGraphic from "../assets/playground/putter/Cart.png";
import startBackground from "../../../oldwebsite/assets/img/bg-start-here.png";
import faceBackground from "../assets/playground/putter/bg-section-2b.png";
import alignmentBackground from "../assets/playground/putter/bg-section-2.png";
import toulonResult from "../assets/playground/putter/toulon.jpg";
import strokeLabResult from "../assets/playground/putter/stroke-lab-black.jpg";
import tripleTrackResult from "../assets/playground/putter/triple-track.jpg";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const quizSource = readFileSync(resolve(process.cwd(), "src/assets/playground/quiz/quiz-source.html"), "utf8");
const customizerSource = readFileSync(resolve(process.cwd(), "src/assets/playground/customizer/source.html"), "utf8");
const customizerSvgStart = customizerSource.indexOf('<svg version="1.1" id="main"');
const customizerSvgEnd = customizerSource.indexOf("</svg>", customizerSvgStart);
const customizerSvg = customizerSvgStart >= 0 && customizerSvgEnd > customizerSvgStart
  ? customizerSource.slice(customizerSvgStart, customizerSvgEnd + 6)
  : "";
const legacyQuestionMatches = [...quizSource.matchAll(/<div class="question-group"><input type="radio" name="Q(\d+)" value="([A-I])"><span>([\s\S]*?)<\/span>/g)];
const questionMap = new Map<number, { value: string; text: string }[]>();
legacyQuestionMatches.forEach((match) => {
  const number = Number(match[1]);
  const text = match[3].replace(/<[^>]+>/g, "").replace(/&nbsp;/g, " ").replace(/&#39;/g, "'").trim();
  questionMap.set(number, [...(questionMap.get(number) ?? []), { value: match[2], text }]);
});
const legacyQuestions = [...questionMap.entries()].sort(([a], [b]) => a - b).map(([number, choices]) => ({ number, choices }));
const resultCodes = ["A", "B", "C", "D", "E", "F", "G", "H", "I"];

function extractLegacyResult(source: string, marker: string) {
  const start = source.indexOf(marker);
  if (start < 0) return "";

  const contentStart = start + marker.length;
  const divTags = /<\/?div\b[^>]*>/gi;
  divTags.lastIndex = contentStart;
  let depth = 1;
  let tag: RegExpExecArray | null;

  while ((tag = divTags.exec(source))) {
    depth += tag[0].startsWith("</") ? -1 : 1;
    if (depth === 0) return source.slice(contentStart, tag.index);
  }

  return "";
}

const legacyResults = resultCodes.map((code, index) => {
  const startMarker = `<div class="row summary" id="type${index + 1}">`;
  return { code, html: extractLegacyResult(quizSource, startMarker) };
});

const finishColors = [
  { label: "White", color: "#ffffff", opacity: "1", blend: "normal" },
  { label: "Tour Silver", color: "#9e9e9e", opacity: "1", blend: "normal" },
  { label: "Chocolate", color: "#2a1203", opacity: "1", blend: "normal" },
  { label: "Black", color: "#111111", opacity: "1", blend: "normal" },
];
const detailColors = [
  { label: "White", color: "#ffffff", opacity: "1", blend: "normal" },
  { label: "Black", color: "#000000", opacity: "1", blend: "normal" },
  { label: "Light Green", color: "#136730", opacity: "1", blend: "normal" },
  { label: "Yellow", color: "#dac93d", opacity: "1", blend: "normal" },
  { label: "Orange", color: "#cf5300", opacity: "1", blend: "normal" },
  { label: "Light Blue", color: "#0080c5", opacity: "1", blend: "normal" },
  { label: "Pink", color: "#bc81c1", opacity: "1", blend: "normal" },
  { label: "Red", color: "#941b1e", opacity: "1", blend: "normal" },
  { label: "Light Brown", color: "#9f703a", opacity: "1", blend: "normal" },
  { label: "No color", color: "transparent", opacity: "0", blend: "normal" },
];
const customizerGroups = [
  { label: "Finish color", target: "#back-panel", colors: finishColors },
  { label: "Hosel (Toulon) color", target: "#details", colors: detailColors },
  { label: "Swirl color", target: "#zippers", colors: detailColors },
  { label: "Alignment color", target: "#mid-panel", colors: detailColors },
  { label: "Odyssey logo color", target: "#front-side-panel", colors: detailColors },
];

const projects = [
  { id: "putter", label: "Interactive demo", title: "Putter Selector Tool", description: "A visual product selector rebuilt with clearer steps and navigation.", image: putterSelectorPreview, alt: "Visual putter selector from Julian's earlier portfolio", featured: true },
  { id: "quiz", label: "UX + development", title: "Personality Quiz", description: "The complete paired-choice quiz and original personality results.", image: personalityQuizPreview, alt: "Personality quiz from Julian's earlier portfolio" },
  { id: "customizer", label: "Interactive experiment", title: "Product Customizer", description: "Customize five details on the original putter SVG, or generate a combination at random.", image: customizerPreview, alt: "Product customizer experiment from Julian's earlier portfolio" },
];
---

<section class="work-group playground-work-group" aria-labelledby="playground-group-heading" data-playground>
  <header class="group-header">
    <div><p class="eyebrow">Archive, rebuilt</p><h3 id="playground-group-heading">Other Fun Projects</h3></div>
    <p>Three earlier interactions rebuilt as small, hands-on demos. Open one and try it.</p>
  </header>

  <div class="project-composition playground-project-rail" tabindex="0" role="group" aria-label="Scrollable Other Fun Projects collection" data-project-rail>
    {projects.map((project) => (
      <article class="playground-project" style={`--project-light-cover: url(${sampleCover.src})`}>
        <button class="card-link" type="button" data-playground-open={project.id} aria-haspopup="dialog" aria-label={`Open ${project.title} interactive demo`}><span class="visually-hidden">Open {project.title} interactive demo</span></button>
        <div class="project-media"><img src={project.image.src} width={project.image.width} height={project.image.height} alt={project.alt} loading="lazy" decoding="async" /></div>
        <div class="project-copy">
          <div class="project-meta"><span class="project-index">{project.label}</span>{project.featured && <span class="featured-pill">Featured</span>}</div>
          <h4>{project.title}</h4><p>{project.description}</p>
          <span class="open-demo">Try the demo <span aria-hidden="true">↗</span></span>
        </div>
      </article>
    ))}
  </div>
  <div class="collection-cue" data-rail-cue hidden><span>Scroll for more projects</span><span class="rail-progress" aria-hidden="true"><i data-rail-progress></i></span></div>

  <dialog class="playground-dialog" data-playground-dialog="putter" aria-labelledby="putter-title">
    <div class="dialog-shell">
      <div class="putter-demo" data-putter-demo data-toulon-src={toulonResult.src} data-stroke-src={strokeLabResult.src} data-triple-src={tripleTrackResult.src} style={`--start-bg:url(${startBackground.src});--face-bg:url(${faceBackground.src});--alignment-bg:url(${alignmentBackground.src})`}>
        <div class="selector-landscape" aria-hidden="true"><img class="selector-cloud" src={cloudGraphic.src} alt="" /><img class="selector-cart" src={cartGraphic.src} alt="" /><svg class="selector-connections" preserveAspectRatio="none"><path pathLength="1" data-connector="insert"/><path pathLength="1" data-connector="milled"/><path pathLength="1" data-connector="traditional"/><path pathLength="1" data-connector="advanced"/></svg></div>
        <div class="putter-sticky-stack">
          <header class="dialog-header"><div><span class="dialog-kicker">Interactive archive</span><h3 id="putter-title">Putter Selector</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Putter Selector">×</button></header>
          <div class="selector-toolbar">
            <nav class="demo-steps" aria-label="Putter selector progress"><button type="button" data-putter-nav="1" disabled>1. Face</button><button type="button" data-putter-nav="2" disabled>2. Alignment</button><button type="button" data-putter-nav="3" disabled>3. Result</button></nav>
            <div class="selector-selections" aria-live="polite"><span>Selection:</span><button type="button" data-selection-face hidden></button><button type="button" data-selection-alignment hidden></button></div>
          </div>
        </div>
        <section class="putter-stage selector-start-stage" data-putter-stage="0"><div class="stage-content"><p class="step-count">Visual product selector</p><h4>Which putter should you try?</h4><p>Make a few visual choices to find the putter technology that best matches your preferences.</p><button class="selector-start-button" type="button" data-putter-start>Start now</button></div></section>
        <section class="putter-stage face-stage" data-putter-stage="1" hidden><div class="stage-content"><p class="step-count">Step 1 of 2</p><h4>Choose your putter's face</h4><div class="choice-grid"><button type="button" data-putter-choice="face" data-value="Insert" data-connector-source="insert"><img src={microFace.src} width={microFace.width} height={microFace.height} alt="Close view of the original Microhinge insert graphic" /><strong>Insert</strong><small>Microhinge insert</small></button><button type="button" data-putter-choice="face" data-value="Milled" data-connector-source="milled"><img src={milledFace.src} width={milledFace.width} height={milledFace.height} alt="Close view of the original Deep Diamond Mill graphic" /><strong>Milled</strong><small>Deep Diamond Mill</small></button></div></div></section>
        <section class="putter-stage alignment-stage" data-putter-stage="2" hidden><div class="stage-content"><p class="step-count">Step 2 of 2</p><h4>Choose your alignment aid</h4><div class="choice-grid"><button type="button" data-putter-choice="alignment" data-value="Traditional" data-connector-source="traditional" disabled><img src={traditionalAlignment.src} width={traditionalAlignment.width} height={traditionalAlignment.height} alt="Original traditional alignment-line graphic" /><strong>Traditional</strong><small>Traditional line</small></button><button type="button" data-putter-choice="alignment" data-value="Advanced" data-connector-source="advanced" disabled><img src={advancedAlignment.src} width={advancedAlignment.width} height={advancedAlignment.height} alt="Original Triple Track alignment graphic" /><strong>Advanced</strong><small>Triple Track technology</small></button></div><button class="back-button" type="button" data-putter-back>Back to face</button></div></section>
        <section class="putter-stage result-stage" data-putter-stage="3" hidden aria-live="polite"><div class="stage-content"><p class="step-count">Your results</p><div class="putter-result-card"><div><h4 data-putter-result-title>Stroke Lab Black</h4><p data-putter-result-copy></p></div><img data-putter-result-image src={strokeLabResult.src} alt="" /></div><div class="result-actions"><button type="button" data-putter-edit>Change selection</button><button type="button" data-putter-reset>Start over</button></div></div></section>
      </div>
    </div>
  </dialog>

  <dialog class="playground-dialog" data-playground-dialog="quiz" aria-labelledby="quiz-title">
    <div class="dialog-shell">
      <header class="dialog-header"><div><span class="dialog-kicker">Interactive archive</span><h3 id="quiz-title">Personality Quiz</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Personality Quiz">×</button></header>
      <div class="quiz-demo" data-quiz-demo data-question-total={legacyQuestions.length}>
        <div class="quiz-progress"><span data-quiz-progress-label>Questions 1–2 of {legacyQuestions.length}</span><i><b data-quiz-progress></b></i></div>
        <form data-quiz-form>
          {legacyQuestions.map((question, index) => <fieldset data-quiz-question={index} hidden={index > 1}><legend>Question {question.number}. Choose the statement that describes you best.</legend>{question.choices.map((choice) => <label><input type="radio" name={`q${index}`} value={choice.value} /> <span>{choice.text}</span></label>)}</fieldset>)}
          <div class="quiz-actions"><button type="button" data-quiz-back disabled>Back</button><button type="button" data-quiz-next disabled>Next</button></div>
        </form>
        <div class="quiz-result" data-quiz-result hidden aria-live="polite"><span>Your result</span><h4 data-quiz-result-title></h4><p>The result uses the original 36-question scoring and original result content.</p><div class="quiz-result-details">{legacyResults.map((result) => <section data-result-code={result.code} hidden set:html={result.html} />)}</div><button type="button" data-quiz-reset>Take it again</button></div>
      </div>
    </div>
  </dialog>

  <dialog class="playground-dialog" data-playground-dialog="customizer" aria-labelledby="customizer-title">
    <div class="dialog-shell">
      <header class="dialog-header"><div><span class="dialog-kicker">Interactive experiment</span><h3 id="customizer-title">Product Customizer</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Product Customizer">×</button></header>
      <div class="customizer-demo" data-customizer-demo>
        <div class="customizer-canvas" role="img" aria-label="Original Odyssey putter illustration with customizable finish, hosel, swirl, alignment, and logo colors" set:html={customizerSvg}></div>
        <div class="customizer-controls">
          {customizerGroups.map((group) => (
            <fieldset class="customizer-group" data-customizer-group={group.target}>
              <legend>{group.label}</legend>
              <div class="customizer-swatches">
                {group.colors.map((color) => (
                  <button
                    type="button"
                    class:list={["customizer-swatch", color.opacity === "0" && "is-none"]}
                    style={`--swatch-color:${color.color}`}
                    data-custom-color={color.color}
                    data-custom-opacity={color.opacity}
                    data-custom-blend={color.blend}
                    aria-label={`${group.label}: ${color.label}`}
                    title={color.label}
                  ><span class="visually-hidden">{color.label}</span></button>
                ))}
              </div>
            </fieldset>
          ))}
          <button class="customizer-randomize" type="button" data-customizer-randomize>Randomize</button>
          <p class="customizer-status visually-hidden" aria-live="polite" data-customizer-status></p>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  function initPlaygrounds() {
    document.querySelectorAll<HTMLElement>("[data-playground]:not([data-ready])").forEach((root) => {
      root.dataset.ready = "true";
      let opener: HTMLElement | null = null;
      root.querySelectorAll<HTMLButtonElement>("[data-playground-open]").forEach((button) => button.addEventListener("click", () => { opener = button; root.querySelector<HTMLDialogElement>(`[data-playground-dialog="${button.dataset.playgroundOpen}"]`)?.showModal(); }));
      root.querySelectorAll<HTMLDialogElement>("[data-playground-dialog]").forEach((dialog) => {
        dialog.querySelector<HTMLButtonElement>("[data-dialog-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
        dialog.addEventListener("close", () => opener?.focus());
      });

      const putter = root.querySelector<HTMLElement>("[data-putter-demo]");
      if (putter) {
        const selections: Record<string, string> = {};
        const shell = putter.closest<HTMLElement>(".dialog-shell")!;
        const dialog = putter.closest<HTMLDialogElement>("dialog")!;
        const stages = [...putter.querySelectorAll<HTMLElement>("[data-putter-stage]")];
        const faceChip = putter.querySelector<HTMLButtonElement>("[data-selection-face]")!;
        const alignmentChip = putter.querySelector<HTMLButtonElement>("[data-selection-alignment]")!;
        const alignmentChoices = [...putter.querySelectorAll<HTMLButtonElement>('[data-putter-choice="alignment"]')];
        const connectionSvg = putter.querySelector<SVGSVGElement>(".selector-connections")!;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let unlockedStage = 0;
        let activeStage = 0;
        let motionFrame = 0;
        const motionCurrent: Record<string, { x: number; y: number } | undefined> = {};

        const scrollToStage = (index: number) => {
          const stage = stages[index];
          if (!stage || stage.hidden) return;
          shell.scrollTo({ top: Math.max(0, putter.offsetTop + stage.offsetTop - 62), behavior: reduceMotion ? "auto" : "smooth" });
        };
        const updateNavigation = (activeStage: number) => {
          putter.dataset.activeStage = String(activeStage);
          putter.querySelectorAll<HTMLButtonElement>("[data-putter-nav]").forEach((nav) => {
            const stage = Number(nav.dataset.putterNav);
            nav.classList.toggle("is-current", stage === activeStage);
            nav.disabled = stage > unlockedStage;
          });
        };
        const updateSelections = () => {
          faceChip.hidden = !selections.face;
          faceChip.textContent = selections.face || "";
          alignmentChip.hidden = !selections.alignment || selections.face === "Milled";
          alignmentChip.textContent = selections.alignment || "";
          putter.querySelectorAll<HTMLButtonElement>("[data-putter-choice]").forEach((choice) => {
            const type = choice.dataset.putterChoice!;
            choice.classList.toggle("is-selected", selections[type] === choice.dataset.value);
          });
          putter.querySelectorAll<SVGPathElement>("[data-connector]").forEach((path) => {
            const connector = path.dataset.connector;
            const selected = connector === selections.face?.toLowerCase() || connector === selections.alignment?.toLowerCase();
            path.classList.toggle("is-selected", selected);
          });
        };
        const updateResult = () => { const milled = selections.face === "Milled"; const advanced = selections.alignment === "Advanced"; const title = milled ? "Toulon Design" : advanced ? "Triple Track" : "Stroke Lab Black"; const copy = milled ? "A union of premium materials, intelligent design, craftsmanship, shaping, and advanced performance technologies." : advanced ? "Triple Track uses Vernier Hyper Acuity to improve alignment for better putting accuracy." : "Stroke Lab combines a premium black finish with the performance technologies of the original collection."; const image = milled ? putter.dataset.toulonSrc! : advanced ? putter.dataset.tripleSrc! : putter.dataset.strokeSrc!; putter.querySelector<HTMLElement>("[data-putter-result-title]")!.textContent = title; putter.querySelector<HTMLElement>("[data-putter-result-copy]")!.textContent = copy; const resultImage = putter.querySelector<HTMLImageElement>("[data-putter-result-image]")!; resultImage.src = image; resultImage.alt = `${title} result from the original putter selector`; };
        const updateConnectionPaths = () => {
          const putterRect = putter.getBoundingClientRect();
          const width = putter.clientWidth;
          const height = putter.scrollHeight;
          const viewBox = `0 0 ${width} ${height}`;
          if (connectionSvg.getAttribute("viewBox") !== viewBox) connectionSvg.setAttribute("viewBox", viewBox);
          if (connectionSvg.style.height !== `${height}px`) connectionSvg.style.height = `${height}px`;
          const definitions = [
            { name: "insert", navStage: 2 },
            { name: "milled", navStage: 3 },
            { name: "traditional", navStage: 3 },
            { name: "advanced", navStage: 3 },
          ];
          definitions.forEach(({ name, navStage }) => {
            const source = putter.querySelector<HTMLElement>(`[data-connector-source="${name}"]`);
            const path = putter.querySelector<SVGPathElement>(`[data-connector="${name}"]`);
            const destination = putter.querySelector<HTMLElement>(`[data-putter-nav="${navStage}"]`);
            if (!source || !path || !destination || source.getClientRects().length === 0) { path?.removeAttribute("d"); return; }
            const sourceRect = source.getBoundingClientRect();
            const endRect = destination.getBoundingClientRect();
            const startX = sourceRect.left - putterRect.left + sourceRect.width / 2;
            const startY = sourceRect.top - putterRect.top + 12;
            const finishX = endRect.left - putterRect.left + endRect.width / 2;
            const finishY = endRect.bottom - putterRect.top;
            const routeX = startX < width / 2 ? width * .06 : width * .94;
            path.setAttribute("d", `M ${startX} ${startY} H ${routeX} V ${finishY} H ${finishX}`);
          });
        };

        const updateLandscape = () => {
          motionFrame = 0;
          if (!dialog.open) return;
          const width = putter.clientWidth;
          const height = putter.scrollHeight;
          const offset = Math.max(0, shell.scrollTop - putter.offsetTop);
          const scrollRange = Math.max(1, height - shell.clientHeight);
          const progress = Math.min(1, (activeStage + Math.min(1, offset / scrollRange) * .35) / 3);
          const items = [
            { name: "cart", element: putter.querySelector<HTMLElement>(".selector-cart")!, start: { percent: .3, x: -.1, y: .45 }, end: { percent: .6, x: 1.2, y: .45 } },
            { name: "cloud", element: putter.querySelector<HTMLElement>(".selector-cloud")!, start: { percent: .15, x: .3, y: .05 }, end: { percent: .7, x: .01, y: .6 } },
          ];
          let moving = false;
          items.forEach((item) => {
            const span = item.end.percent - item.start.percent;
            const local = Math.max(0, Math.min(1, (progress - item.start.percent) / span));
            const target = { x: (item.start.x + (item.end.x - item.start.x) * local) * width, y: (item.start.y + (item.end.y - item.start.y) * local) * height };
            const current = motionCurrent[item.name] || { ...target };
            const next = reduceMotion ? target : { x: current.x + (target.x - current.x) * .08, y: current.y + (target.y - current.y) * .25 };
            motionCurrent[item.name] = next;
            item.element.style.transform = `translate3d(${next.x}px,${next.y}px,0)`;
            moving ||= Math.abs(target.x - next.x) > .4 || Math.abs(target.y - next.y) > .4;
          });
          if (moving) motionFrame = window.requestAnimationFrame(updateLandscape);
        };
        const scheduleLandscape = () => { if (!motionFrame) motionFrame = window.requestAnimationFrame(updateLandscape); };
        const updateFromScroll = () => {
          updateNavigation(activeStage);
          scheduleLandscape();
        };

        const displayStage = (index: number) => {
          activeStage = index;
          stages.forEach((stage, stageIndex) => { stage.hidden = stageIndex !== index; });
          updateNavigation(index);
          window.requestAnimationFrame(() => {
            updateConnectionPaths();
            scheduleLandscape();
            scrollToStage(index);
          });
        };
        const revealStage = (index: number) => {
          if (!stages[index]) return;
          unlockedStage = Math.max(unlockedStage, index);
          displayStage(index);
        };
        const lockAfter = (index: number) => {
          unlockedStage = index;
          displayStage(index);
        };
        const resetJourney = () => {
          Object.keys(selections).forEach((key) => delete selections[key]);
          alignmentChoices.forEach((choice) => choice.disabled = true);
          lockAfter(0);
          updateSelections();
          shell.scrollTo({ top: 0, behavior: "auto" });
        };

        putter.querySelector("[data-putter-start]")?.addEventListener("click", () => revealStage(1));
        putter.querySelectorAll<HTMLButtonElement>("[data-putter-choice]").forEach((button) => button.addEventListener("click", () => {
          const type = button.dataset.putterChoice!;
          selections[type] = button.dataset.value!;
          if (type === "face") {
            delete selections.alignment;
            lockAfter(1);
            if (button.dataset.value === "Milled") {
              selections.alignment = "Not required";
              alignmentChoices.forEach((choice) => choice.disabled = true);
              updateResult();
              updateSelections();
              revealStage(3);
            } else {
              alignmentChoices.forEach((choice) => choice.disabled = false);
              updateSelections();
              revealStage(2);
            }
          } else {
            updateResult();
            updateSelections();
            revealStage(3);
          }
        }));
        putter.querySelector("[data-putter-back]")?.addEventListener("click", () => displayStage(1));
        faceChip.addEventListener("click", () => { delete selections.alignment; lockAfter(1); alignmentChoices.forEach((choice) => choice.disabled = true); updateSelections(); });
        alignmentChip.addEventListener("click", () => { lockAfter(2); updateSelections(); });
        putter.querySelector("[data-putter-edit]")?.addEventListener("click", () => { const target = selections.face === "Milled" ? 1 : 2; lockAfter(target); });
        putter.querySelectorAll<HTMLButtonElement>("[data-putter-nav]").forEach((nav) => nav.addEventListener("click", () => { const target = Number(nav.dataset.putterNav); if (target <= unlockedStage) displayStage(target); }));
        putter.querySelector("[data-putter-reset]")?.addEventListener("click", resetJourney);
        shell.addEventListener("scroll", updateFromScroll, { passive: true });
        new ResizeObserver(() => { updateConnectionPaths(); scheduleLandscape(); }).observe(putter);
        dialog.addEventListener("toggle", () => { if (dialog.open) window.setTimeout(() => { resetJourney(); updateConnectionPaths(); updateFromScroll(); }, 0); });
        dialog.addEventListener("close", () => { if (motionFrame) window.cancelAnimationFrame(motionFrame); motionFrame = 0; });
        resetJourney();
      }

      const quiz = root.querySelector<HTMLElement>("[data-quiz-demo]");
      if (quiz) {
        let index = 0; const total = Number(quiz.dataset.questionTotal || 36); const answers: string[] = [];
        const pairAnswered = () => answers[index] && answers[index + 1];
        const render = () => {
          quiz.querySelectorAll<HTMLElement>("[data-quiz-question]").forEach((question) => {
            const questionIndex = Number(question.dataset.quizQuestion);
            question.hidden = questionIndex < index || questionIndex > index + 1;
          });
          quiz.querySelector<HTMLElement>("[data-quiz-progress-label]")!.textContent = `Questions ${index + 1}–${Math.min(index + 2, total)} of ${total}`;
          quiz.querySelector<HTMLElement>("[data-quiz-progress]")!.style.width = `${(Math.min(index + 2, total) / total) * 100}%`;
          const back = quiz.querySelector<HTMLButtonElement>("[data-quiz-back]")!;
          const next = quiz.querySelector<HTMLButtonElement>("[data-quiz-next]")!;
          back.disabled = index === 0;
          next.textContent = index >= total - 2 ? "See result" : "Next two";
          next.disabled = !pairAnswered();
        };
        quiz.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((input) => input.addEventListener("change", () => {
          const question = input.closest<HTMLElement>("[data-quiz-question]");
          if (question) answers[Number(question.dataset.quizQuestion)] = input.value;
          quiz.querySelector<HTMLButtonElement>("[data-quiz-next]")!.disabled = !pairAnswered();
        }));
        quiz.querySelector("[data-quiz-back]")?.addEventListener("click", () => { if (index > 0) { index = Math.max(0, index - 2); render(); } });
        quiz.querySelector("[data-quiz-next]")?.addEventListener("click", () => { if (index < total - 2) { index += 2; render(); return; } const counts = answers.reduce<Record<string, number>>((all, value) => ({ ...all, [value]: (all[value] || 0) + 1 }), {}); const code = Object.entries(counts).sort((a,b) => b[1] - a[1])[0]?.[0] || "C"; const names: Record<string,string> = { A:"Type One: The Perfectionist", B:"Type Two: The Helper", C:"Type Three: The Achiever", D:"Type Four: The Individualist", E:"Type Five: The Investigator", F:"Type Six: The Loyalist", G:"Type Seven: The Enthusiast", H:"Type Eight: The Challenger", I:"Type Nine: The Peacemaker" }; quiz.querySelector("[data-quiz-form]")?.setAttribute("hidden", ""); quiz.querySelector<HTMLElement>("[data-quiz-result]")!.hidden = false; quiz.querySelector<HTMLElement>("[data-quiz-result-title]")!.textContent = names[code]; quiz.querySelectorAll<HTMLElement>("[data-result-code]").forEach((result) => result.hidden = result.dataset.resultCode !== code); });
        quiz.querySelector("[data-quiz-reset]")?.addEventListener("click", () => { index = 0; answers.splice(0); quiz.querySelector<HTMLFormElement>("[data-quiz-form]")!.reset(); quiz.querySelector("[data-quiz-form]")?.removeAttribute("hidden"); quiz.querySelector<HTMLElement>("[data-quiz-result]")!.hidden = true; quiz.querySelectorAll<HTMLElement>("[data-result-code]").forEach((result) => result.hidden = true); render(); }); render();
      }

      const customizer = root.querySelector<HTMLElement>("[data-customizer-demo]");
      if (customizer) {
        const status = customizer.querySelector<HTMLElement>("[data-customizer-status]");
        const groups = [...customizer.querySelectorAll<HTMLElement>("[data-customizer-group]")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const randomizeTimers: number[] = [];

        const applyColor = (group: HTMLElement, button: HTMLButtonElement, announce = true) => {
          const targetSelector = group.dataset.customizerGroup;
          const target = targetSelector ? customizer.querySelector<SVGElement>(targetSelector) : null;
          if (!target) return;

          target.querySelectorAll<SVGElement>(".svg").forEach((part) => {
            const hasColor = button.dataset.customColor !== "transparent";
            part.setAttribute("fill", hasColor ? button.dataset.customColor || "transparent" : "transparent");
            part.setAttribute("fill-opacity", hasColor ? "1" : "0");
            part.style.mixBlendMode = "normal";
            part.removeAttribute("mix-blend-mode");
          });
          group.querySelectorAll<HTMLButtonElement>("[data-custom-color]").forEach((swatch) => {
            const selected = swatch === button;
            swatch.classList.toggle("is-selected", selected);
            swatch.setAttribute("aria-pressed", String(selected));
          });
          if (announce && status) status.textContent = button.getAttribute("aria-label") || "Customizer color updated";
        };

        groups.forEach((group) => group.querySelectorAll<HTMLButtonElement>("[data-custom-color]").forEach((button) => {
          button.setAttribute("aria-pressed", "false");
          button.addEventListener("click", () => applyColor(group, button));
        }));

        customizer.querySelector<HTMLButtonElement>("[data-customizer-randomize]")?.addEventListener("click", () => {
          randomizeTimers.splice(0).forEach((timer) => window.clearTimeout(timer));
          groups.forEach((group, index) => {
            const choices = [...group.querySelectorAll<HTMLButtonElement>("[data-custom-color]")];
            const current = choices.find((choice) => choice.classList.contains("is-selected"));
            const available = choices.filter((choice) => choice !== current);
            const choice = (available.length ? available : choices)[Math.floor(Math.random() * (available.length || choices.length))];
            if (!choice) return;
            const run = () => applyColor(group, choice, index === groups.length - 1);
            if (reduceMotion) run();
            else randomizeTimers.push(window.setTimeout(run, index * 140));
          });
        });

        customizer.closest("dialog")?.addEventListener("close", () => randomizeTimers.splice(0).forEach((timer) => window.clearTimeout(timer)));
      }

    });
  }
  initPlaygrounds(); document.addEventListener("astro:page-load", initPlaygrounds);
</script>

