---
import putterSelectorPreview from "../assets/legacy/selector.jpg";
import personalityQuizPreview from "../assets/legacy/quiz.jpg";
import customizerPreview from "../assets/legacy/Customizer.jpg";
import sampleCover from "../assets/home/project-covers/sample.png";
import microFace from "../assets/playground/putter/Micro.png";
import milledFace from "../assets/playground/putter/Milled.png";
import traditionalAlignment from "../assets/playground/putter/TraditionalA.png";
import advancedAlignment from "../assets/playground/putter/TT.png";
import cloudGraphic from "../assets/playground/putter/lg-cloud.png";
import cartGraphic from "../assets/playground/putter/Cart.png";
import startBackground from "../assets/playground/putter/bg-start-here.png";
import faceBackground from "../assets/playground/putter/bg-section-2b.png";
import alignmentBackground from "../assets/playground/putter/bg-section-2.png";
import toulonResult from "../assets/playground/putter/toulon.jpg";
import strokeLabResult from "../assets/playground/putter/stroke-lab-black.jpg";
import tripleTrackResult from "../assets/playground/putter/triple-track.jpg";
import shape1Thumbnail from "../assets/playground/customizer/shape-1-thumbnail.svg";
import shape2Thumbnail from "../assets/playground/customizer/shape-2-thumbnail.svg";
import shape3Thumbnail from "../assets/playground/customizer/shape-3-thumbnail.svg";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const quizSource = readFileSync(resolve(process.cwd(), "src/assets/playground/quiz/quiz-source.html"), "utf8");
const customizerSvg = readFileSync(resolve(process.cwd(), "src/assets/playground/customizer/putters.svg"), "utf8");
const legacyQuestionMatches = [...quizSource.matchAll(/<div class="question-group"><input type="radio" name="Q(\d+)" value="([A-I])"><span>([\s\S]*?)<\/span>/g)];
const questionMap = new Map<number, { value: string; text: string }[]>();
legacyQuestionMatches.forEach((match) => {
  const number = Number(match[1]);
  const text = match[3].replace(/<[^>]+>/g, "").replace(/&nbsp;/g, " ").replace(/&#39;/g, "'").trim();
  questionMap.set(number, [...(questionMap.get(number) ?? []), { value: match[2], text }]);
});
const legacyQuestions = [...questionMap.entries()].sort(([a], [b]) => a - b).map(([number, choices]) => ({ number, choices }));
const resultCodes = ["A", "B", "C", "D", "E", "F", "G", "H", "I"];

function extractLegacyResult(source: string, marker: string) {
  const start = source.indexOf(marker);
  if (start < 0) return "";

  const contentStart = start + marker.length;
  const divTags = /<\/?div\b[^>]*>/gi;
  divTags.lastIndex = contentStart;
  let depth = 1;
  let tag: RegExpExecArray | null;

  while ((tag = divTags.exec(source))) {
    depth += tag[0].startsWith("</") ? -1 : 1;
    if (depth === 0) return source.slice(contentStart, tag.index);
  }

  return "";
}

const legacyResults = resultCodes.map((code, index) => {
  const startMarker = `<div class="row summary" id="type${index + 1}">`;
  return { code, html: extractLegacyResult(quizSource, startMarker) };
});
const personalityTypes = [
  { code: "A", number: 1, name: "The Perfectionist", prompt: "Principled, purposeful, and motivated to improve what could be better." },
  { code: "B", number: 2, name: "The Helper", prompt: "Caring, generous, and attentive to what other people need." },
  { code: "C", number: 3, name: "The Achiever", prompt: "Driven, adaptable, and focused on making meaningful progress." },
  { code: "D", number: 4, name: "The Individualist", prompt: "Expressive, perceptive, and drawn to authenticity and meaning." },
  { code: "E", number: 5, name: "The Investigator", prompt: "Curious, independent, and energized by understanding how things work." },
  { code: "F", number: 6, name: "The Loyalist", prompt: "Committed, responsible, and alert to what helps people feel secure." },
  { code: "G", number: 7, name: "The Enthusiast", prompt: "Spontaneous, optimistic, and excited by possibility and experience." },
  { code: "H", number: 8, name: "The Challenger", prompt: "Decisive, protective, and comfortable taking action with confidence." },
  { code: "I", number: 9, name: "The Peacemaker", prompt: "Receptive, reassuring, and naturally aware of multiple perspectives." },
];

const finishColors = [
  { label: "White", color: "#ffffff", opacity: "1", blend: "normal" },
  { label: "Tour Silver", color: "#9e9e9e", opacity: "1", blend: "normal" },
  { label: "Chocolate", color: "#2a1203", opacity: "1", blend: "normal" },
  { label: "Black", color: "#111111", opacity: "1", blend: "normal" },
];
const detailColors = [
  { label: "White", color: "#ffffff", opacity: "1", blend: "normal" },
  { label: "Black", color: "#000000", opacity: "1", blend: "normal" },
  { label: "Light Green", color: "#136730", opacity: "1", blend: "normal" },
  { label: "Yellow", color: "#dac93d", opacity: "1", blend: "normal" },
  { label: "Orange", color: "#cf5300", opacity: "1", blend: "normal" },
  { label: "Light Blue", color: "#0080c5", opacity: "1", blend: "normal" },
  { label: "Pink", color: "#bc81c1", opacity: "1", blend: "normal" },
  { label: "Red", color: "#941b1e", opacity: "1", blend: "normal" },
  { label: "Light Brown", color: "#9f703a", opacity: "1", blend: "normal" },
  { label: "No color", color: "transparent", opacity: "0", blend: "normal" },
];
const customizerGroups = [
  { key: "back-panel", label: "Finish color", colors: finishColors },
  { key: "details", label: "Additional section", colors: detailColors },
  { key: "zippers", label: "Swirl color", colors: detailColors },
  { key: "mid-panel", label: "Alignment color", colors: detailColors },
  { key: "front-side-panel", label: "Odyssey logo color", colors: detailColors },
];

const projects = [
  { id: "putter", label: "Interactive demo", title: "Putter Selector Tool", description: "A visual product selector rebuilt with clearer steps and navigation.", image: putterSelectorPreview, alt: "Visual putter selector from Julian's earlier portfolio", featured: true },
  { id: "quiz", label: "UX + development", title: "Personality Quiz", description: "Explore what brings out your best and where you can grow.", image: personalityQuizPreview, alt: "Personality quiz from Julian's earlier portfolio" },
  { id: "customizer", label: "Interactive experiment", title: "Product Customizer", description: "Customize the available details across three putter shapes, or generate a combination at random.", image: customizerPreview, alt: "Product customizer experiment from Julian's earlier portfolio" },
];
---

<section class="work-group playground-work-group" aria-labelledby="playground-group-heading" data-playground>
  <header class="group-header">
    <div><p class="eyebrow">Archive, rebuilt</p><h3 id="playground-group-heading">Other Fun Projects</h3></div>
    <p>Three earlier interactions rebuilt as small, hands-on demos. Open one and try it.</p>
  </header>

  <div class="project-composition playground-project-rail" tabindex="0" role="group" aria-label="Scrollable Other Fun Projects collection" data-project-rail>
    {projects.map((project) => (
      <article class="related-project playground-project" style={`--project-light-cover: url(${sampleCover.src})`}>
        <button class="card-link" type="button" data-playground-open={project.id} aria-haspopup="dialog" aria-label={`Open ${project.title} interactive demo`}><span class="visually-hidden">Open {project.title} interactive demo</span></button>
        <div class="project-media related-media"><img src={project.image.src} width={project.image.width} height={project.image.height} alt={project.alt} loading="lazy" decoding="async" /></div>
        <div class="project-copy related-copy">
          <div class="project-meta"><span class="project-index">{project.label}</span>{project.featured && <span class="featured-pill">Featured</span>}</div>
          <h4>{project.title}</h4><p>{project.description}</p>
          <span class="open-demo">Try the demo <span aria-hidden="true">↗</span></span>
        </div>
      </article>
    ))}
  </div>
  <div class="collection-cue" data-rail-cue hidden><span>Scroll for more projects</span><span class="rail-progress" aria-hidden="true"><i data-rail-progress></i></span></div>

  <dialog class="playground-dialog" data-playground-dialog="putter" aria-labelledby="putter-title">
    <div class="dialog-shell">
      <div class="putter-demo" data-putter-demo data-toulon-src={toulonResult.src} data-stroke-src={strokeLabResult.src} data-triple-src={tripleTrackResult.src} style={`--start-bg:url(${startBackground.src});--face-bg:url(${faceBackground.src});--alignment-bg:url(${alignmentBackground.src})`}>
        <div class="selector-landscape" aria-hidden="true"><img class="selector-cloud" src={cloudGraphic.src} alt="" /><img class="selector-cart" src={cartGraphic.src} alt="" /></div>
        <div class="putter-sticky-stack">
          <header class="dialog-header"><div><span class="dialog-kicker">Interactive archive</span><h3 id="putter-title">Putter Selector</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Putter Selector">×</button></header>
          <div class="selector-toolbar"><div class="selector-selections" aria-live="polite"><span>Selection:</span><button type="button" data-selection-face hidden></button><button type="button" data-selection-alignment hidden></button></div></div>
        </div>
        <section class="putter-stage selector-start-stage" data-putter-stage="0"><div class="stage-content"><p class="step-count">Visual product selector</p><h4>Which putter should you try?</h4><p>Make a few visual choices to find the putter technology that best matches your preferences.</p><button class="selector-start-button" type="button" data-putter-start>Start now</button></div></section>
        <section class="putter-stage face-stage" data-putter-stage="1" hidden><div class="stage-content"><p class="step-count">Step 1 of 2</p><h4>Choose your putter's face</h4><div class="choice-grid"><button type="button" data-putter-choice="face" data-value="Insert"><img src={microFace.src} width={microFace.width} height={microFace.height} alt="Close view of the original Microhinge insert graphic" /><strong>Insert</strong><small>Microhinge insert</small></button><button type="button" data-putter-choice="face" data-value="Milled"><img src={milledFace.src} width={milledFace.width} height={milledFace.height} alt="Close view of the original Deep Diamond Mill graphic" /><strong>Milled</strong><small>Deep Diamond Mill</small></button></div></div></section>
        <section class="putter-stage alignment-stage" data-putter-stage="2" hidden><div class="stage-content"><p class="step-count">Step 2 of 2</p><h4>Choose your alignment aid</h4><div class="choice-grid"><button type="button" data-putter-choice="alignment" data-value="Traditional" disabled><img src={traditionalAlignment.src} width={traditionalAlignment.width} height={traditionalAlignment.height} alt="Original traditional alignment-line graphic" /><strong>Traditional</strong><small>Traditional line</small></button><button type="button" data-putter-choice="alignment" data-value="Advanced" disabled><img src={advancedAlignment.src} width={advancedAlignment.width} height={advancedAlignment.height} alt="Original Triple Track alignment graphic" /><strong>Advanced</strong><small>Triple Track technology</small></button></div><button class="back-button" type="button" data-putter-back>Back to face</button></div></section>
        <section class="putter-stage result-stage" data-putter-stage="3" hidden aria-live="polite"><div class="stage-content"><p class="step-count">Your results</p><div class="putter-result-card"><div><h4 data-putter-result-title>Stroke Lab Black</h4><p data-putter-result-copy></p></div><img data-putter-result-image src={strokeLabResult.src} alt="" /></div><div class="result-actions"><button type="button" data-putter-edit>Change selection</button><button type="button" data-putter-reset>Start over</button></div></div></section>
      </div>
    </div>
  </dialog>

  <dialog class="playground-dialog" data-playground-dialog="quiz" aria-labelledby="quiz-title">
    <div class="dialog-shell">
      <header class="dialog-header"><div><span class="dialog-kicker">Interactive archive</span><h3 id="quiz-title">Personality Quiz</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Personality Quiz">×</button></header>
      <div class="quiz-demo" data-quiz-demo data-question-total={legacyQuestions.length}>
        <section class="quiz-home" data-quiz-home>
          <div class="enneagram-orbit" aria-hidden="true"><span class="orbit-center">9</span>{personalityTypes.map((type) => <i style={`--type-index:${type.number - 1}`}>{type.number}</i>)}</div>
          <div class="quiz-home-copy"><p class="step-count">9 ways of seeing the world</p><h4>How well do you know yourself?</h4><p>Use this Enneagram-based quiz to better understand yourself, help others understand you, recognize what brings out your best, and identify where you can grow.</p><div class="quiz-home-actions"><button class="quiz-primary" type="button" data-quiz-start>Start the quiz <span aria-hidden="true">→</span></button><button class="quiz-secondary" type="button" data-quiz-explore>Explore personalities</button></div><small>36 paired-choice questions. This short quiz is an exploratory tool, not a scientifically validated assessment.</small></div>
        </section>
        <section class="quiz-taking" data-quiz-taking hidden><div class="quiz-progress"><span data-quiz-progress-label>Questions 1–2 of {legacyQuestions.length}</span><i><b data-quiz-progress></b></i></div><form data-quiz-form>{legacyQuestions.map((question, index) => <fieldset data-quiz-question={index} hidden={index > 1}><legend>Question {question.number}. Choose the statement that describes you best.</legend>{question.choices.map((choice) => <label><input type="radio" name={`q${index}`} value={choice.value} /> <span>{choice.text}</span></label>)}</fieldset>)}<div class="quiz-actions"><button type="button" data-quiz-back>Back to quiz home</button><button type="button" data-quiz-next disabled>Next</button></div></form></section>
        <section class="personality-explorer" data-quiz-explorer hidden><header class="explorer-intro"><div><p class="step-count">Explore the nine types</p><h4>Different motivations. Different ways of moving through the world.</h4></div><button type="button" data-quiz-home-link>Back to quiz home</button></header><nav class="type-picker" aria-label="Choose an Enneagram personality type">{personalityTypes.map((type) => <button type="button" data-explore-type={type.code} aria-label={`Explore Type ${type.number}, ${type.name}`}><span>{type.number}</span><small>{type.name.replace("The ", "")}</small></button>)}</nav><article class="explorer-card" aria-live="polite"><div class="explorer-summary"><span data-explore-number>01</span><div><p>Enneagram type</p><h4 data-explore-title>The Perfectionist</h4><p data-explore-prompt>{personalityTypes[0].prompt}</p></div></div><div class="quiz-result-details explorer-details">{legacyResults.map((result) => <section data-explore-result={result.code} hidden={result.code !== "A"} set:html={result.html} />)}</div><div class="explorer-controls"><button type="button" data-explore-previous aria-label="Previous personality type">← Previous</button><span data-explore-position>1 of 9</span><button type="button" data-explore-next>Next type →</button></div></article></section>
        <div class="quiz-result" data-quiz-result hidden aria-live="polite"><span>Your Enneagram result</span><h4 data-quiz-result-title></h4><p>Your result uses the original 36-question scoring and result content.</p><div class="quiz-result-details">{legacyResults.map((result) => <section data-result-code={result.code} hidden set:html={result.html} />)}</div><div class="quiz-result-actions"><button type="button" data-quiz-reset>Take it again</button><button type="button" data-result-explore>Explore all personalities</button></div></div>
      </div>
    </div>
  </dialog>

  <dialog class="playground-dialog" data-playground-dialog="customizer" aria-labelledby="customizer-title">
    <div class="dialog-shell">
      <header class="dialog-header"><div><span class="dialog-kicker">Interactive experiment</span><h3 id="customizer-title">Product Customizer</h3></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close Product Customizer">×</button></header>
      <div class="customizer-demo" data-customizer-demo>
        <div class="customizer-stage"><span class="customizer-preview-label">Live preview</span><div class="customizer-canvas" role="img" aria-label="Customizable putter illustration" aria-live="polite"><div class="customizer-shape" set:html={customizerSvg}></div></div><div class="customizer-preview-footer"><span data-customizer-shape-name>Shape 1 concept</span><span data-customizer-count>Original configuration</span></div></div>
        <div class="customizer-controls">
          <div class="customizer-controls-header"><span>Make it yours</span><strong>Customize the details</strong></div>
          <fieldset class="customizer-shape-picker">
            <legend>Head shape</legend>
            <div>
              <button type="button" data-custom-shape-choice="blade" aria-pressed="true"><img src={shape1Thumbnail.src} alt="" aria-hidden="true" /><span>Shape 1</span></button>
              <button type="button" data-custom-shape-choice="wing" aria-pressed="false"><img src={shape2Thumbnail.src} alt="" aria-hidden="true" /><span>Shape 2</span></button>
              <button type="button" data-custom-shape-choice="rounded" aria-pressed="false"><img src={shape3Thumbnail.src} alt="" aria-hidden="true" /><span>Shape 3</span></button>
            </div>
          </fieldset>
          {customizerGroups.map((group) => (
            <fieldset class="customizer-group" data-customizer-group={group.key}>
              <legend><span>{group.label}</span><output data-custom-current>Original</output></legend>
              <div class="customizer-swatches">
                {group.colors.map((color) => (
                  <button
                    type="button"
                    class:list={["customizer-swatch", color.opacity === "0" && "is-none"]}
                    style={`--swatch-color:${color.color}`}
                    data-custom-color={color.color}
                    data-custom-opacity={color.opacity}
                    data-custom-blend={color.blend}
                    data-custom-label={color.label}
                    aria-label={`${group.label}: ${color.label}`}
                    title={color.label}
                  ><span class="visually-hidden">{color.label}</span></button>
                ))}
              </div>
            </fieldset>
          ))}
          <div class="customizer-actions"><button class="customizer-randomize" type="button" data-customizer-randomize><span aria-hidden="true">↻</span> Surprise me</button><button class="customizer-reset" type="button" data-customizer-reset disabled>Reset</button></div>
          <p class="customizer-status visually-hidden" aria-live="polite" data-customizer-status></p>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  function initPlaygrounds() {
    document.querySelectorAll<HTMLElement>("[data-playground]:not([data-ready])").forEach((root) => {
      root.dataset.ready = "true";
      let opener: HTMLElement | null = null;
      root.querySelectorAll<HTMLButtonElement>("[data-playground-open]").forEach((button) => button.addEventListener("click", () => { opener = button; root.querySelector<HTMLDialogElement>(`[data-playground-dialog="${button.dataset.playgroundOpen}"]`)?.showModal(); }));
      root.querySelectorAll<HTMLDialogElement>("[data-playground-dialog]").forEach((dialog) => {
        dialog.querySelector<HTMLButtonElement>("[data-dialog-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
        dialog.addEventListener("close", () => opener?.focus());
      });

      const putter = root.querySelector<HTMLElement>("[data-putter-demo]");
      if (putter) {
        const selections: Record<string, string> = {};
        const shell = putter.closest<HTMLElement>(".dialog-shell")!;
        const dialog = putter.closest<HTMLDialogElement>("dialog")!;
        const stages = [...putter.querySelectorAll<HTMLElement>("[data-putter-stage]")];
        const faceChip = putter.querySelector<HTMLButtonElement>("[data-selection-face]")!;
        const alignmentChip = putter.querySelector<HTMLButtonElement>("[data-selection-alignment]")!;
        const alignmentChoices = [...putter.querySelectorAll<HTMLButtonElement>('[data-putter-choice="alignment"]')];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let activeStage = 0;
        let motionFrame = 0;
        const motionCurrent: Record<string, { x: number; y: number } | undefined> = {};

        const scrollToStage = (index: number) => {
          const stage = stages[index];
          if (!stage || stage.hidden) return;
          shell.scrollTo({ top: Math.max(0, putter.offsetTop + stage.offsetTop - 62), behavior: reduceMotion ? "auto" : "smooth" });
        };
        const updateSelections = () => {
          faceChip.hidden = !selections.face;
          faceChip.textContent = selections.face || "";
          alignmentChip.hidden = !selections.alignment || selections.face === "Milled";
          alignmentChip.textContent = selections.alignment || "";
          putter.querySelectorAll<HTMLButtonElement>("[data-putter-choice]").forEach((choice) => {
            const type = choice.dataset.putterChoice!;
            choice.classList.toggle("is-selected", selections[type] === choice.dataset.value);
          });
        };
        const updateResult = () => { const milled = selections.face === "Milled"; const advanced = selections.alignment === "Advanced"; const title = milled ? "Toulon Design" : advanced ? "Triple Track" : "Stroke Lab Black"; const copy = milled ? "A union of premium materials, intelligent design, craftsmanship, shaping, and advanced performance technologies." : advanced ? "Triple Track uses Vernier Hyper Acuity to improve alignment for better putting accuracy." : "Stroke Lab combines a premium black finish with the performance technologies of the original collection."; const image = milled ? putter.dataset.toulonSrc! : advanced ? putter.dataset.tripleSrc! : putter.dataset.strokeSrc!; putter.querySelector<HTMLElement>("[data-putter-result-title]")!.textContent = title; putter.querySelector<HTMLElement>("[data-putter-result-copy]")!.textContent = copy; const resultImage = putter.querySelector<HTMLImageElement>("[data-putter-result-image]")!; resultImage.src = image; resultImage.alt = `${title} result from the original putter selector`; };
        const updateLandscape = () => {
          motionFrame = 0;
          if (!dialog.open) return;
          const width = putter.clientWidth;
          const height = putter.scrollHeight;
          const offset = Math.max(0, shell.scrollTop - putter.offsetTop);
          const scrollRange = Math.max(1, height - shell.clientHeight);
          const progress = Math.min(1, (activeStage + Math.min(1, offset / scrollRange) * .35) / 3);
          const items = [{ name: "cloud", element: putter.querySelector<HTMLElement>(".selector-cloud")!, start: { percent: .15, x: .3, y: .05 }, end: { percent: .7, x: .01, y: .6 } }];
          let moving = false;
          items.forEach((item) => {
            const span = item.end.percent - item.start.percent;
            const local = Math.max(0, Math.min(1, (progress - item.start.percent) / span));
            const target = { x: (item.start.x + (item.end.x - item.start.x) * local) * width, y: (item.start.y + (item.end.y - item.start.y) * local) * height };
            const current = motionCurrent[item.name] || { ...target };
            const next = reduceMotion ? target : { x: current.x + (target.x - current.x) * .08, y: current.y + (target.y - current.y) * .25 };
            motionCurrent[item.name] = next;
            item.element.style.transform = `translate3d(${next.x}px,${next.y}px,0)`;
            moving ||= Math.abs(target.x - next.x) > .4 || Math.abs(target.y - next.y) > .4;
          });
          if (moving) motionFrame = window.requestAnimationFrame(updateLandscape);
        };
        const scheduleLandscape = () => { if (!motionFrame) motionFrame = window.requestAnimationFrame(updateLandscape); };
        const updateFromScroll = () => scheduleLandscape();

        const displayStage = (index: number) => {
          activeStage = index;
          putter.dataset.activeStage = String(index);
          stages.forEach((stage, stageIndex) => { stage.hidden = stageIndex !== index; });
          window.requestAnimationFrame(() => {
            scheduleLandscape();
            scrollToStage(index);
          });
        };
        const revealStage = (index: number) => {
          if (!stages[index]) return;
          displayStage(index);
        };
        const lockAfter = (index: number) => displayStage(index);
        const resetJourney = () => {
          Object.keys(selections).forEach((key) => delete selections[key]);
          alignmentChoices.forEach((choice) => choice.disabled = true);
          lockAfter(0);
          updateSelections();
          shell.scrollTo({ top: 0, behavior: "auto" });
        };

        putter.querySelector("[data-putter-start]")?.addEventListener("click", () => revealStage(1));
        putter.querySelectorAll<HTMLButtonElement>("[data-putter-choice]").forEach((button) => button.addEventListener("click", () => {
          const type = button.dataset.putterChoice!;
          selections[type] = button.dataset.value!;
          if (type === "face") {
            delete selections.alignment;
            lockAfter(1);
            if (button.dataset.value === "Milled") {
              selections.alignment = "Not required";
              alignmentChoices.forEach((choice) => choice.disabled = true);
              updateResult();
              updateSelections();
              revealStage(3);
            } else {
              alignmentChoices.forEach((choice) => choice.disabled = false);
              updateSelections();
              revealStage(2);
            }
          } else {
            updateResult();
            updateSelections();
            revealStage(3);
          }
        }));
        putter.querySelector("[data-putter-back]")?.addEventListener("click", () => displayStage(1));
        faceChip.addEventListener("click", () => { delete selections.alignment; lockAfter(1); alignmentChoices.forEach((choice) => choice.disabled = true); updateSelections(); });
        alignmentChip.addEventListener("click", () => { lockAfter(2); updateSelections(); });
        putter.querySelector("[data-putter-edit]")?.addEventListener("click", () => { const target = selections.face === "Milled" ? 1 : 2; lockAfter(target); });
        putter.querySelector("[data-putter-reset]")?.addEventListener("click", resetJourney);
        shell.addEventListener("scroll", updateFromScroll, { passive: true });
        new ResizeObserver(scheduleLandscape).observe(putter);
        dialog.addEventListener("toggle", () => { if (dialog.open) window.setTimeout(() => { resetJourney(); updateFromScroll(); }, 0); });
        dialog.addEventListener("close", () => { if (motionFrame) window.cancelAnimationFrame(motionFrame); motionFrame = 0; });
        resetJourney();
      }

      const quiz = root.querySelector<HTMLElement>("[data-quiz-demo]");
      if (quiz) {
        let index = 0; let exploredIndex = 0; const total = Number(quiz.dataset.questionTotal || 36); const answers: string[] = [];
        const quizDialog = quiz.closest<HTMLDialogElement>("dialog")!;
        const quizShell = quiz.closest<HTMLElement>(".dialog-shell")!;
        const typeData = [
          { code:"A", number:1, name:"The Perfectionist", prompt:"Principled, purposeful, and motivated to improve what could be better." },
          { code:"B", number:2, name:"The Helper", prompt:"Caring, generous, and attentive to what other people need." },
          { code:"C", number:3, name:"The Achiever", prompt:"Driven, adaptable, and focused on making meaningful progress." },
          { code:"D", number:4, name:"The Individualist", prompt:"Expressive, perceptive, and drawn to authenticity and meaning." },
          { code:"E", number:5, name:"The Investigator", prompt:"Curious, independent, and energized by understanding how things work." },
          { code:"F", number:6, name:"The Loyalist", prompt:"Committed, responsible, and alert to what helps people feel secure." },
          { code:"G", number:7, name:"The Enthusiast", prompt:"Spontaneous, optimistic, and excited by possibility and experience." },
          { code:"H", number:8, name:"The Challenger", prompt:"Decisive, protective, and comfortable taking action with confidence." },
          { code:"I", number:9, name:"The Peacemaker", prompt:"Receptive, reassuring, and naturally aware of multiple perspectives." },
        ];
        const home = quiz.querySelector<HTMLElement>("[data-quiz-home]")!;
        const taking = quiz.querySelector<HTMLElement>("[data-quiz-taking]")!;
        const explorer = quiz.querySelector<HTMLElement>("[data-quiz-explorer]")!;
        const resultView = quiz.querySelector<HTMLElement>("[data-quiz-result]")!;
        const showView = (view: HTMLElement) => {
          [home, taking, explorer, resultView].forEach((section) => section.hidden = section !== view);
          quizShell.scrollTo({ top: 0, behavior: "auto" });
        };
        const pairAnswered = () => answers[index] && answers[index + 1];
        const render = () => {
          quiz.querySelectorAll<HTMLElement>("[data-quiz-question]").forEach((question) => {
            const questionIndex = Number(question.dataset.quizQuestion);
            question.hidden = questionIndex < index || questionIndex > index + 1;
          });
          quiz.querySelector<HTMLElement>("[data-quiz-progress-label]")!.textContent = `Questions ${index + 1}–${Math.min(index + 2, total)} of ${total}`;
          quiz.querySelector<HTMLElement>("[data-quiz-progress]")!.style.width = `${(Math.min(index + 2, total) / total) * 100}%`;
          const back = quiz.querySelector<HTMLButtonElement>("[data-quiz-back]")!;
          const next = quiz.querySelector<HTMLButtonElement>("[data-quiz-next]")!;
          back.disabled = false;
          back.textContent = index === 0 ? "Back to quiz home" : "Previous two";
          next.textContent = index >= total - 2 ? "See result" : "Next two";
          next.disabled = !pairAnswered();
        };
        const resetAnswers = () => {
          index = 0; answers.splice(0); quiz.querySelector<HTMLFormElement>("[data-quiz-form]")!.reset();
          quiz.querySelectorAll<HTMLElement>("[data-result-code]").forEach((result) => result.hidden = true);
          render();
        };
        const startQuiz = () => { resetAnswers(); showView(taking); };
        const renderExplorer = (nextIndex: number) => {
          exploredIndex = (nextIndex + typeData.length) % typeData.length;
          const type = typeData[exploredIndex];
          quiz.querySelector<HTMLElement>("[data-explore-number]")!.textContent = String(type.number).padStart(2, "0");
          quiz.querySelector<HTMLElement>("[data-explore-title]")!.textContent = type.name;
          quiz.querySelector<HTMLElement>("[data-explore-prompt]")!.textContent = type.prompt;
          quiz.querySelector<HTMLElement>("[data-explore-position]")!.textContent = `${type.number} of 9`;
          quiz.querySelectorAll<HTMLButtonElement>("[data-explore-type]").forEach((button) => {
            const selected = button.dataset.exploreType === type.code;
            button.classList.toggle("is-current", selected);
            button.setAttribute("aria-current", selected ? "true" : "false");
          });
          quiz.querySelectorAll<HTMLElement>("[data-explore-result]").forEach((section) => section.hidden = section.dataset.exploreResult !== type.code);
          quiz.querySelector(".explorer-card")?.scrollIntoView({ block:"start", behavior:"auto" });
        };
        const openExplorer = (typeIndex = exploredIndex) => { renderExplorer(typeIndex); showView(explorer); };
        quiz.querySelector("[data-quiz-start]")?.addEventListener("click", startQuiz);
        quiz.querySelector("[data-quiz-explore]")?.addEventListener("click", () => openExplorer(0));
        quiz.querySelector("[data-result-explore]")?.addEventListener("click", () => openExplorer(typeData.findIndex((type) => resultView.querySelector("[data-quiz-result-title]")?.textContent?.includes(type.name))));
        quiz.querySelector("[data-quiz-home-link]")?.addEventListener("click", () => showView(home));
        quiz.querySelectorAll<HTMLButtonElement>("[data-explore-type]").forEach((button) => button.addEventListener("click", () => renderExplorer(typeData.findIndex((type) => type.code === button.dataset.exploreType))));
        quiz.querySelector("[data-explore-previous]")?.addEventListener("click", () => renderExplorer(exploredIndex - 1));
        quiz.querySelector("[data-explore-next]")?.addEventListener("click", () => renderExplorer(exploredIndex + 1));
        quiz.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((input) => input.addEventListener("change", () => {
          const question = input.closest<HTMLElement>("[data-quiz-question]");
          if (question) answers[Number(question.dataset.quizQuestion)] = input.value;
          quiz.querySelector<HTMLButtonElement>("[data-quiz-next]")!.disabled = !pairAnswered();
        }));
        quiz.querySelector("[data-quiz-back]")?.addEventListener("click", () => {
          if (index === 0) { showView(home); return; }
          index = Math.max(0, index - 2);
          render();
        });
        quiz.querySelector("[data-quiz-next]")?.addEventListener("click", () => { if (index < total - 2) { index += 2; render(); return; } const counts = answers.reduce<Record<string, number>>((all, value) => ({ ...all, [value]: (all[value] || 0) + 1 }), {}); const code = Object.entries(counts).sort((a,b) => b[1] - a[1])[0]?.[0] || "C"; const type = typeData.find((item) => item.code === code) || typeData[2]; quiz.querySelector<HTMLElement>("[data-quiz-result-title]")!.textContent = `Type ${type.number}: ${type.name}`; quiz.querySelectorAll<HTMLElement>("[data-result-code]").forEach((result) => result.hidden = result.dataset.resultCode !== code); showView(resultView); });
        quiz.querySelector("[data-quiz-reset]")?.addEventListener("click", startQuiz);
        quizDialog.addEventListener("toggle", () => { if (quizDialog.open) { resetAnswers(); showView(home); renderExplorer(0); showView(home); } });
        render(); showView(home);
      }

      const customizer = root.querySelector<HTMLElement>("[data-customizer-demo]");
      if (customizer) {
        const status = customizer.querySelector<HTMLElement>("[data-customizer-status]");
        const groups = [...customizer.querySelectorAll<HTMLElement>("[data-customizer-group]")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const randomizeTimers: number[] = [];
        const resetButton = customizer.querySelector<HTMLButtonElement>("[data-customizer-reset]")!;
        const selectionCount = customizer.querySelector<HTMLElement>("[data-customizer-count]")!;
        const shapeName = customizer.querySelector<HTMLElement>("[data-customizer-shape-name]")!;
        const shapeButtons = [...customizer.querySelectorAll<HTMLButtonElement>("[data-custom-shape-choice]")];
        const shapeLabels: Record<string, string> = { blade: "Shape 1", wing: "Shape 2", rounded: "Shape 3" };
        const shapeIds: Record<string, string> = { blade: "shape_1", wing: "shape_2", rounded: "shape_3" };
        const shapeTargets: Record<string, Record<string, string>> = {
          blade: {
            "back-panel": "#shape_1 #back-panel",
            "zippers": "#shape_1 #zippers",
            "mid-panel": "#shape_1 #mid-panel",
            "front-side-panel": "#shape_1 #front-side-panel",
          },
          wing: {
            "back-panel": "#shape_2 #back-panel2",
            "details": "#shape_2 #details1",
            "mid-panel": "#shape_2 #mid-panel2",
            "front-side-panel": "#shape_2 #front-side-panel1",
          },
          rounded: {
            "back-panel": "#shape_3 #back-panel3",
            "zippers": "#shape_3 #zippers1",
            "mid-panel": "#shape_3 #mid-panel3",
            "front-side-panel": "#shape_3 #front-side-panel2",
            "details": "#shape_3 #details2",
          },
        };
        const shapeElements = Object.entries(shapeIds).map(([shape, id]) => ({ shape, element: customizer.querySelector<SVGElement>(`#${id}`) }));
        const paintableElements = (target: SVGElement) => {
          const selector = "path,polygon,rect,circle,ellipse,line,polyline";
          return [...(target.matches(selector) ? [target] : []), ...target.querySelectorAll<SVGElement>(selector)];
        };
        const targetsForGroup = (key: string) => Object.values(shapeTargets)
          .map((targetMap) => targetMap[key])
          .filter(Boolean)
          .flatMap((selector) => [...customizer.querySelectorAll<SVGElement>(selector)]);
        let activeShape = "blade";
        const originalParts = groups.flatMap((group) => targetsForGroup(group.dataset.customizerGroup || ""))
          .flatMap(paintableElements)
          .filter((part, index, all) => all.indexOf(part) === index)
          .map((part) => ({ part, styleFill: part.style.fill, styleOpacity: part.style.fillOpacity, styleBlend: part.style.mixBlendMode }));

        const refreshCustomizerState = () => {
          const visibleGroups = groups.filter((group) => !group.hidden);
          const changed = visibleGroups.filter((group) => group.querySelector(".customizer-swatch.is-selected")).length;
          const anyChanged = groups.some((group) => group.querySelector(".customizer-swatch.is-selected"));
          const shapeChanged = activeShape !== "blade";
          selectionCount.textContent = changed
            ? `${changed} of ${visibleGroups.length} details customized`
            : shapeChanged ? "Original colors" : "Original configuration";
          resetButton.disabled = !anyChanged && !shapeChanged;
        };

        const selectShape = (shape: string, announce = true) => {
          if (!shapeLabels[shape]) return;
          activeShape = shape;
          shapeElements.forEach((item) => {
            if (!item.element) return;
            const selected = item.shape === shape;
            item.element.style.display = selected ? "inline" : "none";
            item.element.setAttribute("aria-hidden", String(!selected));
          });
          groups.forEach((group) => {
            const key = group.dataset.customizerGroup || "";
            group.hidden = !shapeTargets[shape][key];
          });
          shapeButtons.forEach((button) => {
            const selected = button.dataset.customShapeChoice === shape;
            button.classList.toggle("is-selected", selected);
            button.setAttribute("aria-pressed", String(selected));
          });
          shapeName.textContent = `${shapeLabels[shape]} concept`;
          refreshCustomizerState();
          if (announce && status) status.textContent = `${shapeLabels[shape]} head shape selected`;
        };

        shapeButtons.forEach((button, buttonIndex) => {
          button.addEventListener("click", () => selectShape(button.dataset.customShapeChoice || "blade"));
          button.addEventListener("keydown", (event) => {
            const movement = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
            if (!movement) return;
            event.preventDefault();
            const next = shapeButtons[(buttonIndex + movement + shapeButtons.length) % shapeButtons.length];
            next.focus(); next.click();
          });
        });

        const applyColor = (group: HTMLElement, button: HTMLButtonElement, announce = true) => {
          const targets = targetsForGroup(group.dataset.customizerGroup || "");
          if (!targets.length) return;

          targets.forEach((target) => paintableElements(target).forEach((part) => {
              const hasColor = button.dataset.customColor !== "transparent";
              part.style.fill = hasColor ? button.dataset.customColor || "transparent" : "transparent";
              part.style.fillOpacity = hasColor ? "1" : "0";
              part.style.mixBlendMode = "normal";
            }));
          group.querySelectorAll<HTMLButtonElement>("[data-custom-color]").forEach((swatch) => {
            const selected = swatch === button;
            swatch.classList.toggle("is-selected", selected);
            swatch.setAttribute("aria-pressed", String(selected));
          });
          group.querySelector<HTMLOutputElement>("[data-custom-current]")!.textContent = button.dataset.customLabel || "Selected";
          refreshCustomizerState();
          if (announce && status) status.textContent = button.getAttribute("aria-label") || "Customizer color updated";
        };

        groups.forEach((group) => {
          const swatches = [...group.querySelectorAll<HTMLButtonElement>("[data-custom-color]")];
          swatches.forEach((button, buttonIndex) => {
            button.setAttribute("aria-pressed", "false");
            button.addEventListener("click", () => applyColor(group, button));
            button.addEventListener("keydown", (event) => {
              const movement = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
              if (!movement) return;
              event.preventDefault();
              const next = swatches[(buttonIndex + movement + swatches.length) % swatches.length];
              next.focus(); next.click();
            });
          });
        });

        const resetCustomizer = (announce = true) => {
          randomizeTimers.splice(0).forEach((timer) => window.clearTimeout(timer));
          originalParts.forEach(({ part, styleFill, styleOpacity, styleBlend }) => {
            part.style.fill = styleFill;
            part.style.fillOpacity = styleOpacity;
            part.style.mixBlendMode = styleBlend;
          });
          groups.forEach((group) => {
            group.querySelectorAll<HTMLButtonElement>("[data-custom-color]").forEach((button) => { button.classList.remove("is-selected"); button.setAttribute("aria-pressed", "false"); });
            group.querySelector<HTMLOutputElement>("[data-custom-current]")!.textContent = "Original";
          });
          selectShape("blade", false);
          refreshCustomizerState();
          if (announce && status) status.textContent = "Customizer reset to the original configuration";
        };
        resetButton.addEventListener("click", () => resetCustomizer());

        customizer.querySelector<HTMLButtonElement>("[data-customizer-randomize]")?.addEventListener("click", () => {
          randomizeTimers.splice(0).forEach((timer) => window.clearTimeout(timer));
          const visibleGroups = groups.filter((group) => !group.hidden);
          visibleGroups.forEach((group, index) => {
            const choices = [...group.querySelectorAll<HTMLButtonElement>("[data-custom-color]")];
            const current = choices.find((choice) => choice.classList.contains("is-selected"));
            const available = choices.filter((choice) => choice !== current);
            const choice = (available.length ? available : choices)[Math.floor(Math.random() * (available.length || choices.length))];
            if (!choice) return;
            const run = () => applyColor(group, choice, index === visibleGroups.length - 1);
            if (reduceMotion) run();
            else randomizeTimers.push(window.setTimeout(run, index * 140));
          });
        });

        customizer.closest("dialog")?.addEventListener("close", () => resetCustomizer(false));
        selectShape("blade", false);
      }

    });
  }
  initPlaygrounds(); document.addEventListener("astro:page-load", initPlaygrounds);
</script>

