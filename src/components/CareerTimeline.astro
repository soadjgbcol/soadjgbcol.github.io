---
const milestones = [
  { date: "2008", title: "Design + web foundation", detail: "Started designing, building, and learning how ideas become real experiences." },
  { date: "2018", title: "Interactive Designer", detail: "Joined Callaway Golf Interactive, connecting visual design with production." },
  { date: "2019", title: "Front-End Web Developer", detail: "Moved deeper into how clear, usable experiences are implemented." },
  { date: "2021", title: "Lead, Interactive Design", detail: "Expanded into systems, standards, and team coordination." },
  { date: "2023", title: "Manager, Interactive Design", detail: "Led experience work across brands and improved how the team worked." },
  { date: "Now", title: "Staff Product Designer", detail: "Bringing product judgment, design, building, and practical AI together." },
];
---

<div class="career-path" data-career-path>
  <p class="visually-hidden">A design and building career that began in 2008 and evolved through interactive design, front-end development, design leadership, and staff-level product design.</p>
  <span class="career-signal" aria-hidden="true"></span>
  <ol class="career-timeline">
    {milestones.map((milestone, index) => (
      <li class:list={{ current: index === milestones.length - 1 }} style={`--milestone-index: ${index}`}>
        <span class="date">{milestone.date}</span>
        <span class="node" aria-hidden="true"></span>
        <div>
          <h3>{milestone.title}</h3>
          <p>{milestone.detail}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  const careerObservers = new WeakMap<HTMLElement, IntersectionObserver>();

  function initializeCareerPaths() {
    document.querySelectorAll<HTMLElement>("[data-career-path]:not([data-career-ready])").forEach((path) => {
      path.dataset.careerReady = "true";
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) path.classList.add("is-visible");
      }, { threshold: 0.2 });
      observer.observe(path);
      careerObservers.set(path, observer);
    });
  }

  initializeCareerPaths();
  document.addEventListener("astro:page-load", initializeCareerPaths);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-career-path]").forEach((path) => {
      careerObservers.get(path)?.disconnect();
      careerObservers.delete(path);
      path.removeAttribute("data-career-ready");
    });
  });
</script>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .career-path { --rail-y: calc(var(--space-4) + 2.4rem + 0.64rem); position: relative; padding-top: var(--space-4); }
  .career-path::before {
    position: absolute;
    top: var(--rail-y);
    right: 15.3%;
    left: 1.4%;
    height: 1px;
    background: var(--color-border-strong);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
  }
  .career-signal { position: absolute; z-index: 1; top: calc(var(--rail-y) - 0.275rem); left: 1.4%; width: 0.55rem; height: 0.55rem; border: 2px solid var(--color-canvas); border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent); opacity: 0; pointer-events: none; }
  .career-timeline { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  li { display: grid; position: relative; grid-template-rows: 2.4rem 1.5rem auto; min-width: 0; padding-inline: clamp(0.4rem, 1.1vw, var(--space-3)); opacity: 0; transform: translateY(0.75rem); }
  .date { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .node { position: relative; z-index: 1; width: 0.78rem; height: 0.78rem; margin-top: 0.25rem; border: 1px solid var(--color-text-muted); border-radius: 50%; background: var(--color-canvas); }
  li.current .node { border-color: var(--color-accent); background: var(--color-accent); box-shadow: 0 0 0 0.28rem color-mix(in srgb, var(--color-accent) 10%, transparent); }
  h3 { margin: var(--space-4) 0 var(--space-2); font-size: var(--step-0); line-height: 1.25; }
  p { margin: 0; color: var(--color-text-muted); font-size: 0.76rem; line-height: 1.5; }
  .is-visible::before { animation: rail-draw 1.2s 120ms linear forwards; }
  .is-visible .career-signal { animation: career-travel 1.2s 120ms linear forwards; }
  .is-visible li { animation: milestone-arrive 420ms calc(120ms + var(--milestone-index) * 210ms) ease-out forwards; }
  .is-visible li.current .node { animation: current-pulse 3.5s 1.45s ease-in-out infinite; }
  @keyframes rail-draw { to { transform: scaleX(1); } }
  @keyframes career-travel { 0% { left: 1.4%; opacity: 0; } 5% { opacity: 1; } 92% { opacity: 1; } 100% { left: calc(84.7% - 0.55rem); opacity: 0; } }
  @keyframes milestone-arrive { to { opacity: 1; transform: none; } }
  @keyframes current-pulse { 50% { box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--color-accent) 4%, transparent); } }

  @media (max-width: 64rem) {
    .career-timeline { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6) 0; }
    .career-path::before, .career-signal { display: none; }
    li { grid-template-rows: auto 1.3rem auto; padding: var(--space-3); border-top: 1px solid var(--color-border-strong); }
  }
  @media (max-width: 42rem) {
    .career-path { padding-left: var(--space-5); }
    .career-path::before { display: block; top: 0.5rem; right: auto; bottom: 0.5rem; left: 0.25rem; width: 1px; height: auto; transform: scaleY(0); transform-origin: top; }
    .career-timeline { grid-template-columns: 1fr; gap: 0; }
    li { grid-template-columns: 4.5rem 1rem minmax(0, 1fr); grid-template-rows: auto; align-items: start; padding: 0 0 var(--space-6); border-top: 0; column-gap: var(--space-3); }
    .date { padding-top: 0.1rem; }
    .node { grid-column: 2; grid-row: 1; margin-top: 0.15rem; }
    li > div { grid-column: 3; grid-row: 1; }
    h3 { margin: 0 0 var(--space-2); }
    .is-visible::before { animation-name: rail-draw-mobile; }
  }
  @keyframes rail-draw-mobile { to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .career-path::before, .career-signal, li, li.current .node { animation: none !important; }
    .career-path::before { transform: scaleX(1); }
    .career-signal { display: none; }
    li { opacity: 1; transform: none; }
  }
</style>
