---
const steps = [
  { label: "Visual Editor", note: "Make code editable" },
  { label: "Section Builder", note: "Compose with reusable parts" },
  { label: "Multi-Brand Platform", note: "Share the system, vary the brand" },
  { label: "Validation + Translation", note: "Bring checks into the workflow" },
  { label: "Dual delivery", note: "Support two email platforms" },
  { label: "API + AI workflows", note: "Extend the workflow", progress: true },
];
---

<ol class="evolution-path" aria-label="Teebox product evolution">
  {steps.map((step, index) => (
    <li>
      <div class="evolution-node" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
      <div class="evolution-copy">
        <strong>{step.label}</strong>
        <small>{step.note}</small>
        {step.progress && <em>In progress</em>}
      </div>
    </li>
  ))}
</ol>

<style>
  .evolution-path {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: var(--space-6) 0 0;
    list-style: none;
  }

  .evolution-path li {
    position: relative;
    min-width: 0;
    padding-right: var(--space-3);
  }

  .evolution-path li::before {
    position: absolute;
    top: -1.68rem;
    left: 0.7rem;
    width: calc(100% - 0.2rem);
    height: 1px;
    background: var(--color-accent);
    content: "";
  }

  .evolution-path li:last-child::before { width: 0; }

  .evolution-node {
    position: absolute;
    top: -2.35rem;
    display: grid;
    width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-canvas);
  }

  .evolution-node span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .evolution-copy { display: grid; gap: 0.3rem; }
  .evolution-copy strong { font-size: 0.88rem; line-height: 1.25; }
  .evolution-copy small { color: var(--color-text-muted); font-size: 0.7rem; line-height: 1.4; }
  .evolution-copy em {
    width: fit-content;
    padding: 0.14rem 0.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 50rem) {
    .evolution-path { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-8); }
    .evolution-path li:nth-child(3)::before { width: 0; }
  }

  @media (max-width: 34rem) {
    .evolution-path { display: grid; grid-template-columns: 1fr; gap: 0; padding: 0 0 0 var(--space-5); border-top: 0; border-left: 1px solid var(--color-border-strong); }
    .evolution-path li { min-height: 6.5rem; padding: 0 0 var(--space-5) var(--space-4); }
    .evolution-path li::before { top: 0.7rem; left: -1.28rem; width: 1.25rem !important; }
    .evolution-node { top: 0; left: -2.32rem; background: var(--color-canvas); }
  }
</style>
