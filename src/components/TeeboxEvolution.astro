---
const steps = [
  { date: "June 2025", label: "Prototyping and testing", note: "Test the concept and workflow" },
  { date: "Sept 2025", label: "Visual Editor", note: "Make code editable" },
  { date: "Nov 2025", label: "Section Builder", note: "Compose with reusable parts" },
  { date: "March 2026", label: "Multi-Brand Platform", note: "Share the system, vary the brand", adoption: "Full Callaway adoption" },
  { date: "May 2026", label: "Validation + Translation", note: "Bring checks into the workflow", adoption: "Expanded to the other brands" },
  { date: "June 2026", label: "Dual Delivery", note: "Support two email platforms" },
  { date: "Aug 2026", label: "AI Workflow Connectors", note: "Connect approved AI-assisted email workflows" },
  { date: "Current", label: "Direct API Connections", note: "Connect Teebox directly with email service providers", progress: true },
];
---

<ol class="evolution-path" aria-label="Teebox product evolution from June 2025 through current roadmap work">
  {steps.map((step, index) => (
    <li class:list={{ "is-progress": step.progress }} style={`--step:${index}`}>
      <div class="milestone-marker" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
      <div class="evolution-copy">
        <time>{step.date}</time>
        <strong>{step.label}</strong>
        <small>{step.note}</small>
        {step.adoption && <span class="adoption-note">{step.adoption}</span>}
        {step.progress && <em>In progress</em>}
      </div>
    </li>
  ))}
</ol>

<style>
  .evolution-path {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) 0;
    margin: 0;
    padding: var(--space-3) 0 0;
    list-style: none;
  }

  .evolution-path li {
    position: relative;
    min-width: 0;
    padding: 0 var(--space-5) var(--space-4) 0;
  }

  .evolution-path li::before {
    position: absolute;
    z-index: 0;
    top: 0.69rem;
    left: 1.35rem;
    width: calc(100% - 1.35rem);
    height: 1px;
    background: var(--color-accent);
    content: "";
  }

  .evolution-path li:nth-child(4n)::before { display: none; }

  .milestone-marker {
    display: grid;
    position: relative;
    z-index: 1;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-canvas);
  }

  .milestone-marker span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.5rem;
  }

  .evolution-copy {
    display: grid;
    align-content: start;
    gap: 0.32rem;
    margin-top: var(--space-3);
  }

  .evolution-copy time {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .evolution-copy strong { font-size: 0.92rem; line-height: 1.2; }
  .evolution-copy small { max-width: 12rem; color: var(--color-text-muted); font-size: 0.72rem; line-height: 1.45; }

  .adoption-note {
    width: fit-content;
    margin-top: 0.15rem;
    padding-left: 0.45rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-soft);
    font-size: 0.67rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .evolution-copy em {
    width: fit-content;
    margin-top: 0.15rem;
    padding: 0.14rem 0.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-style: normal;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .evolution-path li { animation: milestone-enter 600ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(var(--step) * 70ms); }
    @keyframes milestone-enter { from { opacity: 0; transform: translateY(0.6rem); } to { opacity: 1; transform: translateY(0); } }
  }

  @media (max-width: 50rem) {
    .evolution-path { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .evolution-path li:nth-child(4n)::before { display: block; }
    .evolution-path li:nth-child(2n)::before { display: none; }
  }

  @media (max-width: 34rem) {
    .evolution-path { grid-template-columns: 1fr; gap: 0; padding: 0 0 0 var(--space-5); border-left: 1px solid var(--color-border-strong); }
    .evolution-path li { min-height: 7.2rem; padding: 0 0 var(--space-5) var(--space-4); }
    .evolution-path li::before { display: block !important; top: 0.7rem; left: -1.28rem; width: 1.25rem; }
    .evolution-path li:last-child::before { display: none !important; }
    .milestone-marker { position: absolute; top: 0; left: -2.32rem; }
    .evolution-copy { margin-top: 0; }
    .evolution-copy small { max-width: 21rem; }
  }
</style>
