---
const builds = [
  { action: "Generate", name: "Gift Card Generator", description: "A self-service HTML tool that turned repeated gift-card design requests into repeatable production assets.", icon: "gift" },
  { action: "Support", name: "Iterable Team Tools", description: "A shared set of utilities for recurring email-team support tasks, keeping small operational needs in one working area.", icon: "tools" },
  { action: "Review", name: "Responsive Viewer", description: "Displays several screen sizes together so designers and developers can compare responsive layouts without opening each view separately.", icon: "responsive" },
  { action: "Validate", name: "Link Checker / QA utilities", description: "Checks links and recurring delivery details before launch, turning a repeated manual review into a consistent quality step.", icon: "check" },
  { action: "Automate", name: "Photoshop automation", description: "Automates repetitive image-production steps when the same preparation pattern needs to be completed across multiple assets.", icon: "layers" },
];
---

<ul class="selected-builds" data-selected-builds>
  {builds.map((build, index) => (
    <li class:list={{ "is-active": index === 0 }} style={`--build-index: ${index}`}>
      <button type="button" aria-expanded={index === 0 ? "true" : "false"}>
        <span class="build-icon" aria-hidden="true">
          {build.icon === "gift" && <svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M12 8v13M3 12h18M12 8c-3.8 0-5.5-1.2-5.5-3 0-1.2.9-2 2.1-2C10.6 3 12 6.1 12 8Zm0 0c3.8 0 5.5-1.2 5.5-3 0-1.2-.9-2-2.1-2C13.4 3 12 6.1 12 8Z"/></svg>}
          {build.icon === "tools" && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M14 14l2-2 3 3-2 2M6 16l5-5"/></svg>}
          {build.icon === "responsive" && <svg viewBox="0 0 24 24"><rect x="2" y="4" width="14" height="11" rx="1"/><path d="M7 20h4M9 15v5"/><rect x="17" y="8" width="5" height="11" rx="1"/></svg>}
          {build.icon === "check" && <svg viewBox="0 0 24 24"><path d="M10 13a4 4 0 0 0 5.7 0l2.3-2.3A4 4 0 0 0 12.3 5L11 6.3M14 11a4 4 0 0 0-5.7 0L6 13.3A4 4 0 0 0 11.7 19l1.3-1.3"/><path d="m16.5 18.5 1.5 1.5 3-4"/></svg>}
          {build.icon === "layers" && <svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/><path d="M18 3v4M16 5h4"/></svg>}
        </span>
        <span class="build-summary">
          <span class="build-action">{build.action}</span>
          <strong>{build.name}</strong>
          <span class="build-description" aria-hidden={index === 0 ? "false" : "true"}>{build.description}</span>
        </span>
        <span class="expand-cue" aria-hidden="true">+</span>
      </button>
    </li>
  ))}
</ul>

<script>
  const buildObservers = new WeakMap<HTMLElement, IntersectionObserver>();
  const buildCleanups = new WeakMap<HTMLElement, () => void>();
  function initializeSelectedBuilds() {
    document.querySelectorAll<HTMLElement>("[data-selected-builds]:not([data-builds-ready])").forEach((list) => {
      list.dataset.buildsReady = "true";
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) list.classList.add("is-visible");
      }, { threshold: 0.18 });
      observer.observe(list);
      buildObservers.set(list, observer);

      const items = Array.from(list.querySelectorAll<HTMLElement>("li"));
      const activate = (item: HTMLElement) => {
        items.forEach((candidate) => {
          const active = candidate === item;
          candidate.classList.toggle("is-active", active);
          candidate.querySelector("button")?.setAttribute("aria-expanded", String(active));
          candidate.querySelector(".build-description")?.setAttribute("aria-hidden", String(!active));
        });
      };
      const onPointerOver = (event: PointerEvent) => {
        if (event.pointerType === "touch") return;
        const item = (event.target as HTMLElement).closest<HTMLElement>("li");
        if (item && list.contains(item)) activate(item);
      };
      const onFocusIn = (event: FocusEvent) => {
        const item = (event.target as HTMLElement).closest<HTMLElement>("li");
        if (item) activate(item);
      };
      const onClick = (event: MouseEvent) => {
        const item = (event.target as HTMLElement).closest<HTMLElement>("li");
        if (item) activate(item);
      };
      list.addEventListener("pointerover", onPointerOver);
      list.addEventListener("focusin", onFocusIn);
      list.addEventListener("click", onClick);
      buildCleanups.set(list, () => {
        observer.disconnect();
        list.removeEventListener("pointerover", onPointerOver);
        list.removeEventListener("focusin", onFocusIn);
        list.removeEventListener("click", onClick);
        list.removeAttribute("data-builds-ready");
      });
    });
  }
  initializeSelectedBuilds();
  document.addEventListener("astro:page-load", initializeSelectedBuilds);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-selected-builds]").forEach((list) => {
      buildCleanups.get(list)?.();
      buildCleanups.delete(list);
      buildObservers.delete(list);
    });
  });
</script>

<style>
  .selected-builds { display: grid; margin: 0; padding: 0; gap: var(--space-2); list-style: none; }
  li { overflow: hidden; border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; background: transparent; opacity: 0; transform: translateY(0.5rem); transition: background-color var(--transition-fast); }
  li:first-child { border-top: 1px solid var(--color-border); }
  li.is-active { background: color-mix(in srgb, var(--color-accent) 4%, transparent); }
  button { display: grid; width: 100%; min-height: 4.5rem; grid-template-columns: 2.75rem minmax(0, 1fr) auto; align-items: center; padding: var(--space-3) var(--space-4); border: 0; background: transparent; color: var(--color-text); font: inherit; gap: var(--space-4); text-align: left; cursor: pointer; }
  button:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -3px; }
  .build-icon { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; color: var(--color-accent); }
  svg { width: 1.35rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .build-summary { display: grid; min-width: 0; grid-template-columns: minmax(5rem, 0.38fr) minmax(0, 1fr); align-items: baseline; gap: var(--space-1) var(--space-4); }
  .build-action { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.07em; text-transform: uppercase; }
  strong { font-size: var(--step-0); }
  .build-description { overflow: hidden; grid-column: 2; max-height: 0; color: var(--color-text-muted); font-size: var(--step--1); line-height: 1.5; opacity: 0; transition: max-height 320ms ease, opacity 220ms ease, padding-top 320ms ease; }
  .is-active .build-description { max-height: 6rem; padding-top: var(--space-2); opacity: 1; }
  .expand-cue { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--step-1); transition: transform 220ms ease; }
  .is-active .expand-cue { transform: rotate(45deg); }
  .is-visible li { animation: build-arrive 420ms calc(160ms + var(--build-index) * 100ms) ease-out forwards; }
  @keyframes build-arrive { to { opacity: 1; transform: none; } }
  @media (max-width: 38rem) {
    button { grid-template-columns: 2.75rem minmax(0, 1fr) auto; padding-inline: var(--space-3); gap: var(--space-3); }
    .build-summary { grid-template-columns: 1fr; }
    .build-description { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    li { animation: none !important; }
    li { opacity: 1; transform: none; }
    .build-description, .expand-cue { transition: none; }
  }
</style>
