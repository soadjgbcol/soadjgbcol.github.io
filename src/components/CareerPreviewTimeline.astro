---
const milestones = [
  { year: "2008", label: "Design + web" },
  { year: "2018", label: "Interactive design" },
  { year: "2019", label: "Front-end" },
  { year: "2021", label: "Design lead" },
  { year: "2023", label: "Design manager" },
  { year: "Now", label: "Staff AI product design" },
];
---

<div class="preview-timeline" data-preview-timeline>
  <span class="timeline-line" aria-hidden="true"></span>
  <ol aria-label="Career progression from 2008 to now">
    {milestones.map((milestone, index) => (
      <li style={`--timeline-index: ${index}`}>
        <span class="year">{milestone.year}</span>
        <i aria-hidden="true"></i>
        <strong>{milestone.label}</strong>
      </li>
    ))}
  </ol>
</div>

<script>
  const previewTimelineObservers = new WeakMap<HTMLElement, IntersectionObserver>();
  function initializePreviewTimelines() {
    document.querySelectorAll<HTMLElement>("[data-preview-timeline]:not([data-timeline-ready])").forEach((timeline) => {
      timeline.dataset.timelineReady = "true";
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) timeline.classList.add("is-visible");
      }, { threshold: 0.25 });
      observer.observe(timeline);
      previewTimelineObservers.set(timeline, observer);
    });
  }
  initializePreviewTimelines();
  document.addEventListener("astro:page-load", initializePreviewTimelines);
</script>

<style>
  .preview-timeline { position: relative; min-width: 0; padding-block: var(--space-4); }
  .timeline-line { position: absolute; z-index: 0; top: 3.45rem; right: 8.5%; left: 1.5%; height: 1px; background: var(--color-accent); transform: scaleX(0); transform-origin: left; }
  ol { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  li { display: grid; position: relative; grid-template-rows: 2rem 1.5rem auto; min-width: 0; padding-right: var(--space-2); opacity: 0; transform: translateY(0.4rem); }
  .year { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.07em; text-transform: uppercase; }
  i { position: relative; z-index: 1; width: 0.72rem; height: 0.72rem; margin-top: 0.1rem; border: 1px solid var(--color-accent); border-radius: 50%; background: var(--color-surface); }
  li:last-child i { background: var(--color-accent); box-shadow: 0 0 0 0.28rem color-mix(in srgb, var(--color-accent) 10%, transparent); }
  strong { max-width: 10ch; padding-top: var(--space-2); font-size: 0.72rem; line-height: 1.35; }
  .is-visible .timeline-line { animation: timeline-draw 1.1s 100ms linear forwards; }
  .is-visible li { animation: timeline-arrive 380ms calc(100ms + var(--timeline-index) * 185ms) ease-out forwards; }
  @keyframes timeline-draw { to { transform: scaleX(1); } }
  @keyframes timeline-arrive { to { opacity: 1; transform: none; } }
  @media (max-width: 48rem) {
    .preview-timeline { padding-left: var(--space-5); }
    .timeline-line { top: 0.5rem; right: auto; bottom: 0.5rem; left: 0.25rem; width: 1px; height: auto; transform: scaleY(0); transform-origin: top; }
    ol { grid-template-columns: 1fr; }
    li { grid-template-columns: 4rem 1rem minmax(0, 1fr); grid-template-rows: auto; min-height: 4.25rem; align-items: start; gap: var(--space-2); }
    .year { grid-column: 1; }
    i { grid-column: 2; grid-row: 1; }
    strong { grid-column: 3; grid-row: 1; max-width: none; padding-top: 0; }
    .is-visible .timeline-line { animation-name: timeline-draw-mobile; }
  }
  @keyframes timeline-draw-mobile { to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .timeline-line, li { animation: none !important; }
    .timeline-line { transform: scaleX(1); }
    li { opacity: 1; transform: none; }
  }
</style>
