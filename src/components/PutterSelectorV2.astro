---
import catalog from "../data/putter-selector-v2-catalog.json";
import cloudGraphic from "../assets/playground/putter/lg-cloud.png";
import cartGraphic from "../assets/playground/putter/Cart.png";
import startBackground from "../assets/playground/putter/bg-start-here.png";
import faceBackground from "../assets/playground/putter/bg-section-2b.png";
import alignmentBackground from "../assets/playground/putter/bg-section-2.png";
import priorityStroke from "../assets/playground/putter/priority-stroke.png";
import priorityShape from "../assets/playground/putter/priority-shape.png";
import priorityAlignment from "../assets/playground/putter/priority-alignment.png";
import priorityFace from "../assets/playground/putter/priority-face.png";
---

<div
  class="putter-v2"
  data-putter-v2
  data-stage="intro"
  data-priority-stroke={priorityStroke.src}
  data-priority-shape={priorityShape.src}
  data-priority-alignment={priorityAlignment.src}
  data-priority-face={priorityFace.src}
  style={`--start-bg:url(${startBackground.src});--face-bg:url(${faceBackground.src});--alignment-bg:url(${alignmentBackground.src})`}
>
  <script type="application/json" data-putter-v2-catalog set:html={JSON.stringify(catalog)} />
  <div class="v2-landscape" aria-hidden="true">
    <img class="v2-cloud" src={cloudGraphic.src} alt="" />
  </div>
  <div class="v2-cart-track" aria-hidden="true">
    <img class="v2-cart" src={cartGraphic.src} alt="" />
  </div>

  <div class="v2-reset-wrap">
    <button type="button" data-v2-reset-all disabled aria-label="Reset putter selector" title="Reset putter selector"><span aria-hidden="true">↻</span></button>
  </div>
  <div class="v2-back-wrap">
    <button type="button" data-v2-back-all hidden aria-label="Go back one step" title="Go back"><span aria-hidden="true">←</span></button>
  </div>

  <section class="v2-stage" data-v2-stage aria-live="polite"></section>
</div>

<script>
  const selectorV2Cleanups = new WeakMap<HTMLElement, () => void>();

  function initializePutterSelectorV2() {
    document.querySelectorAll<HTMLElement>("[data-putter-v2]:not([data-v2-ready])").forEach((root) => {
      root.dataset.v2Ready = "true";
      const catalogSource = root.querySelector<HTMLScriptElement>("[data-putter-v2-catalog]");
      const rawCatalog = JSON.parse(catalogSource?.textContent || "[]") as { name: string; url: string }[];
      const stage = root.querySelector<HTMLElement>("[data-v2-stage]")!;
      const shell = root.closest<HTMLElement>(".dialog-shell");
      const resetAll = root.querySelector<HTMLButtonElement>("[data-v2-reset-all]")!;
      const backAll = root.querySelector<HTMLButtonElement>("[data-v2-back-all]")!;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const priorityImages = {
        shape: root.dataset.priorityShape!,
        alignment: root.dataset.priorityAlignment!,
        stroke: root.dataset.priorityStroke!,
        face: root.dataset.priorityFace!,
      };

      type QuestionKey = "shape" | "alignment" | "stroke" | "face";
      type Product = { name: string; url: string; family: string; shape: string; alignment: string; stroke: string; face: string; image: string; alternateImage: string };
      type Option = { id: string; title: string; copy: string; sub: string; img: string | null };

      const questions: Record<QuestionKey, { title: string; question: string; helper: string; options: Option[] }> = {
        shape: {
          title: "Head Shape",
          question: "Choose a head shape",
          helper: "Pick the profile that looks best behind the ball.",
          options: [
            { id: "blade", title: "Blade", copy: "Compact, traditional heel-and-toe shapes.", sub: "#1 · #2", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-1-ch/putters-2026-ai-dual-1-ch___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "wide", title: "Wide Blade / Compact Mallet", copy: "More footprint without a full-size mallet.", sub: "Double Wide · One Wide · Rossie", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-dw-db/putters-2026-ai-dual-dw-db___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1600" },
            { id: "mallet", title: "Mallet", copy: "Larger shapes built around stability and alignment.", sub: "#7 · Jailbird · 2-Ball · Eleven", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-7-s/putters-2026-ai-dual-7-s___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "any", title: "Any Shape Is Fine", copy: "Keep blades, wide shapes, and mallets in the recommendations.", sub: "No shape preference", img: null },
          ],
        },
        alignment: {
          title: "Alignment",
          question: "Choose an alignment style",
          helper: "Pick the visual cue that makes aiming feel clearest.",
          options: [
            { id: "classic", title: "Classic", copy: "Simple line, dot, or traditional top-line cue.", sub: "Minimal visual complexity", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-7-db/putters-2026-ai-dual-7-db___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "versa", title: "Versa / High Contrast", copy: "Silver-black or black-white contrast designed to make face angle easier to read.", sub: "Includes current Microhinge models", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-cruiser-jailbird-db/putters-2026-ai-dual-cruiser-jailbird-db___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "ball", title: "2-Ball / ½ Ball", copy: "Ball-based alignment that frames or mirrors the golf ball.", sub: "2-Ball · ½ Ball", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-7-1-2-ball-s/putters-2026-ai-dual-7-1-2-ball-s___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "any", title: "Any Alignment Is Fine", copy: "Keep every alignment system in play.", sub: "No alignment preference", img: null },
          ],
        },
        stroke: {
          title: "Stroke / Face Rotation",
          question: "Choose a stroke profile",
          helper: "This describes where and how the shaft connects to the putter head.",
          options: [
            { id: "zero", title: "Zero Torque", copy: "Stroke-balanced, toe-up designs intended to resist face rotation.", sub: "Square 2 Square", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-square-to-square-ai-dual-seven/putters-2026-square-to-square-ai-dual-seven___4.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png" },
            { id: "minimal", title: "Minimal Arc", copy: "Face-balanced or low toe-hang configurations.", sub: "Usually double-bend / low toe hang", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-ai-dual-7-db/putters-2026-ai-dual-7-db___4.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png" },
            { id: "arc", title: "More Arc", copy: "Toe-hang configurations for more face rotation.", sub: "Often slant or crank hosel", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-ai-dual-7-s/putters-2026-ai-dual-7-s___4.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png" },
            { id: "any", title: "Any Stroke Type Is Fine", copy: "Do not narrow recommendations by face rotation.", sub: "No stroke preference", img: null },
          ],
        },
        face: {
          title: "Face / Insert",
          question: "Choose a face feel",
          helper: "Compare soft inserts, roll-focused faces, and milled construction.",
          options: [
            { id: "urethane", title: "Urethane / Soft Insert", copy: "Soft-feeling insert technologies such as Ai-DUAL, Ai-ONE, DFX, and White Hot.", sub: "Soft feel · speed consistency", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-ai-dual-1-ch/putters-2026-ai-dual-1-ch___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "roll", title: "Roll-Focused Insert", copy: "Microhinge technology uses hinges to create immediate topspin and forward roll.", sub: "Microhinge", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2025-microhinge-1-ch/putters-2025-microhinge-1-ch___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1200" },
            { id: "milled", title: "Milled / Metal Face", copy: "Premium metal-face options including Ai-ONE Milled, Damascus Milled, and Red Milled.", sub: "Milled titanium · Damascus steel · all-milled", img: "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-damascus-milled-two-ch/putters-2026-damascus-milled-two-ch___2.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png" },
            { id: "any", title: "Any Face Is Fine", copy: "Let shape, alignment, and stroke drive the recommendation.", sub: "No face preference", img: null },
          ],
        },
      };

      const familyInfo: Record<string, { tag: string; copy: string }> = {
        "Ai-DUAL": { tag: "Ai-DUAL Insert", copy: "Ai-DUAL uses an Ai-designed dual-layer urethane insert with a softer outer layer and firmer inner layer. It is engineered for consistent ball speed across the face, improved forward roll, and soft feel." },
        "Ai-DUAL ½ Ball": { tag: "Ai-DUAL + ½ Ball", copy: "This combines the Ai-DUAL dual-layer urethane insert with Odyssey's ½ Ball alignment system, which frames the golf ball to help with centering and aim." },
        "Ai-DUAL Square 2 Square": { tag: "Ai-DUAL + Zero Torque", copy: "The Ai-DUAL insert is paired with a Square 2 Square stroke-balanced, toe-up configuration designed to reduce face rotation." },
        "Square 2 Square TRI-HOT": { tag: "TRI-HOT + Ai-DUAL", copy: "Square 2 Square TRI-HOT uses multi-material construction and substantial tungsten weighting in a zero-torque setup. Current models also use Odyssey's two-layer Ai-DUAL urethane insert." },
        "Ai-ONE": { tag: "Ai-ONE Insert", copy: "Ai-ONE uses Ai-designed contours behind an aluminum backer to reduce ball-speed loss on off-center strikes, paired with a White Hot urethane striking surface." },
        "Ai-ONE Milled": { tag: "Milled Titanium Ai Insert", copy: "Ai-ONE Milled combines 100% milled construction with an Ai-designed milled titanium insert for more consistent speed control and a refined milled sound and feel." },
        "Microhinge": { tag: "Microhinge Insert", copy: "Microhinge uses tiny hinges in the insert to create immediate topspin and forward roll. The current Microhinge family uses Odyssey Versa alignment." },
        "DFX": { tag: "DFX Insert", copy: "DFX is Odyssey's softest insert family. It is designed for golfers who prefer a noticeably softer sensation at impact." },
        "Damascus Milled": { tag: "Damascus Steel Insert", copy: "Damascus Milled uses a layered Damascus steel insert and precision-milled construction for a highly responsive premium feel." },
        "Damascus Milled S2S": { tag: "Damascus + Zero Torque", copy: "This combines the premium Damascus steel insert with Odyssey's Square 2 Square zero-torque configuration." },
        "Red Milled": { tag: "All-Milled Face", copy: "Red Milled is an all-milled stainless steel putter with a deep diamond-groove face designed to promote forward roll." },
        "Eleven": { tag: "White Hot Insert", copy: "Eleven combines a high-MOI, forward-CG mallet construction with Odyssey's White Hot urethane insert." },
      };

      const answers: Record<QuestionKey, string | null> = { shape: null, alignment: null, stroke: null, face: null };
      const defaultOrder: QuestionKey[] = ["shape", "alignment", "stroke", "face"];
      let priority: QuestionKey = "shape";
      let order: QuestionKey[] = [];
      let current = -1;
      let animating = false;
      let resultPage = 0;
      let resultImageMode: "top" | "sole" = "top";

      const low = (value: string) => value.toLowerCase();
      const inferFamily = (name: string) => {
        const value = low(name);
        if (value.includes("damascus") && (value.includes("square 2 square") || value.includes("square to square"))) return "Damascus Milled S2S";
        if (value.includes("ai-dual") && (value.includes("square 2 square") || value.includes("square to square"))) return "Ai-DUAL Square 2 Square";
        if (value.includes("ai-dual") && (value.includes("½ ball") || value.includes("1/2 ball"))) return "Ai-DUAL ½ Ball";
        if (value.includes("ai-dual")) return "Ai-DUAL";
        if (value.includes("tri-hot")) return "Square 2 Square TRI-HOT";
        if (value.includes("ai-one milled")) return "Ai-ONE Milled";
        if (value.includes("ai-one")) return "Ai-ONE";
        if (value.includes("microhinge")) return "Microhinge";
        if (value.includes("dfx")) return "DFX";
        if (value.includes("damascus")) return "Damascus Milled";
        if (value.includes("red milled")) return "Red Milled";
        if (value.includes("eleven")) return "Eleven";
        return "Other";
      };
      const inferShape = (name: string) => {
        const value = low(name);
        if (value.includes("chipper")) return "other";
        if (value.includes("dfx #10")) return "mallet";
        if (["double wide", "one wide", "rossie", "v-line fang", "2-ball blade"].some((term) => value.includes(term))) return "wide";
        if (["#1", "#2", "two ch", "one ch"].some((term) => value.includes(term))) return "blade";
        return "mallet";
      };
      const inferAlignment = (name: string) => {
        const value = low(name);
        if (value.includes("½ ball") || value.includes("1/2 ball") || value.includes("2-ball")) return "ball";
        if (["microhinge", "jailbird", "freebird", "versa", "stripe"].some((term) => value.includes(term))) return "versa";
        return "classic";
      };
      const inferStroke = (name: string) => {
        const value = low(name);
        if (value.includes("square 2 square") || value.includes("square to square") || value.includes("tri-hot")) return "zero";
        if ([" db", "double bend", "center shaft", " cs", "broomstick", "cruiser"].some((term) => value.includes(term))) return "minimal";
        if ([" s putter", "slant", " ch", "#1", "#2"].some((term) => value.includes(term))) return "arc";
        return "minimal";
      };
      const inferFace = (name: string) => {
        const family = inferFamily(name);
        if (family === "Microhinge") return "roll";
        if (["Ai-ONE Milled", "Damascus Milled", "Damascus Milled S2S", "Red Milled"].includes(family)) return "milled";
        return "urethane";
      };
      const primaryImage = (url: string) => {
        const file = url.split("/").pop()!.replace(".html", "");
        if (file === "putters-2026-damascus-milled-two-ch") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-damascus-milled-two-ch/putters-2026-damascus-milled-two-ch___2.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2026-damascus-milled-one-wide-sb") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-damascus-milled-one-wide-sb/putters-2026-damascus-milled-one-wide-sb___2.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2026-damascus-milled-rossie-s") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2026-damascus-milled-rossie-s/putters-2026-damascus-milled-rossie-s___2.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2026-square-2-square-tri-hot-black-rossie-sb") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-square-2-square-tri-hot-black-rossie-sb/putters-2026-square-2-square-tri-hot-black-rossie-sb___3.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2024-ai-one-cruiser-jailbird-db") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2024-ai-one-cruiser-jailbird-db/putters-2024-ai-one-cruiser-jailbird-db___2.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2025-ai-one-milled-cruiser-jailbird-t-db") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2025-ai-one-milled-cruiser-jailbird-t-db/putters-2025-ai-one-cruiser-jailbird-t-db___1.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        return `https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/${file}/${file}___1.jpg?bgcolor=F7F7F7&q=90&sfrm=png&sw=1600`;
      };
      const soleImage = (url: string) => {
        const file = url.split("/").pop()!.replace(".html", "");
        if (file === "putters-2025-ai-one-milled-cruiser-jailbird-t-db") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/putters-2025-ai-one-milled-cruiser-jailbird-t-db/putters-2025-ai-one-cruiser-jailbird-t-db___4.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        if (file === "putters-2026-square-2-square-tri-hot-black-rossie-sb") return "https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786636131949/sits/putters-2026-square-2-square-tri-hot-black-rossie-sb/putters-2026-square-2-square-tri-hot-black-rossie-sb___4.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png";
        const imageNumber = file.includes("putters-2026-") ? 5 : 4;
        return `https://prd-sfcc.callawaygolf.com/dw/image/v2/AADH_PRD/on/demandware.static/-/Sites-CGI-ItemMaster/en_US/v1786686125751/sits/${file}/${file}___${imageNumber}.jpg?sw=1200&q=90&bgcolor=F7F7F7&sfrm=png`;
      };
      const products: Product[] = rawCatalog.map((item) => ({
        ...item,
        family: inferFamily(item.name),
        shape: inferShape(item.name),
        alignment: inferAlignment(item.name),
        stroke: inferStroke(item.name),
        face: inferFace(item.name),
        image: primaryImage(item.url),
        alternateImage: soleImage(item.url),
      })).filter((item) =>
        item.shape !== "other"
        && !low(item.name).includes("broomstick")
        && !low(item.url).includes("broomstick")
      );

      const categoryLabel = (key: QuestionKey) => ({ shape: "Head Shape", alignment: "Alignment", stroke: "Stroke / Face Control", face: "Face / Insert" })[key];
      const optionLabel = (key: QuestionKey, value: string | null) => questions[key].options.find((option) => option.id === value)?.title || value || "";
      const activeAnswer = (key: QuestionKey) => Boolean(answers[key] && answers[key] !== "any");
      const resultScore = (product: Product) => {
        let total = 0;
        let earned = 0;
        order.forEach((key, index) => {
          if (!activeAnswer(key)) return;
          const weight = index === 0 ? 40 : 20;
          total += weight;
          if (product[key] === answers[key]) earned += weight;
        });
        return total === 0 ? 100 : Math.round((earned / total) * 100);
      };
      const baseAfterMustHave = () => activeAnswer(order[0]) ? products.filter((product) => product[order[0]] === answers[order[0]]) : products;
      const availableShapeIds = () => [...new Set(baseAfterMustHave().map((product) => product.shape))];
      const rankedProducts = () => products
        .filter((product) => !activeAnswer(order[0]) || product[order[0]] === answers[order[0]])
        .filter((product) => !activeAnswer("shape") || product.shape === answers.shape)
        .sort((a, b) => {
          const scoreDifference = resultScore(b) - resultScore(a);
          if (scoreDifference !== 0) return scoreDifference;
          for (let index = 1; index < order.length; index += 1) {
            const key = order[index];
            if (!activeAnswer(key)) continue;
            const aMatches = a[key] === answers[key] ? 1 : 0;
            const bMatches = b[key] === answers[key] ? 1 : 0;
            if (aMatches !== bMatches) return bMatches - aMatches;
          }
          return a.name.localeCompare(b.name);
        })
        .slice(0, 8);

      const setMeta = () => {
        resetAll.disabled = current < 0 && !order.length;
        backAll.hidden = current < 0 || !order.length;
      };
      const transition = (render: () => void) => {
        if (animating) return;
        animating = true;
        stage.classList.add("is-leaving");
        window.setTimeout(() => {
          render();
          shell?.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
          stage.classList.remove("is-leaving");
          stage.classList.add("is-entering");
          window.setTimeout(() => {
            stage.classList.remove("is-entering");
            animating = false;
            stage.querySelector<HTMLElement>("h4, h5")?.focus({ preventScroll: true });
          }, reducedMotion.matches ? 0 : 520);
        }, reducedMotion.matches ? 0 : 260);
      };

      const renderIntro = () => {
        current = -1;
        root.dataset.stage = "intro";
        const options: { id: QuestionKey; title: string; copy: string }[] = [
          { id: "shape", title: "Head Shape", copy: "The putter has to look right behind the ball." },
          { id: "alignment", title: "Alignment", copy: "The aiming picture is what you care about most." },
          { id: "stroke", title: "Stroke / Face Control", copy: "How the face behaves through the stroke is your top priority." },
          { id: "face", title: "Face / Insert", copy: "Feel, roll, and face construction matter most to you." },
        ];
        const priorityGraphic = (id: QuestionKey) => `<img src="${priorityImages[id]}" alt="" loading="eager" decoding="async" />`;
        setMeta("Choose your priority", "Set up");
        stage.innerHTML = `<div class="v2-intro"><p class="v2-kicker">Visual product selector</p><h4 tabindex="-1">Which putter should you try?</h4><p>Choose the one thing that matters most. It will lead the four visual questions and stay protected in your results.</p><div class="v2-priority-grid">${options.map((option) => `<button type="button" class="${priority === option.id && order.length ? "is-selected" : ""}" data-v2-priority="${option.id}" aria-pressed="${priority === option.id && order.length}"><span class="v2-priority-graphic" data-priority-graphic="${option.id}" aria-hidden="true">${priorityGraphic(option.id)}</span><strong>${option.title}</strong><span>${option.copy}</span></button>`).join("")}</div></div>`;
        stage.querySelectorAll<HTMLButtonElement>("[data-v2-priority]").forEach((button) => button.addEventListener("click", () => {
          priority = button.dataset.v2Priority as QuestionKey;
          order = [priority, ...defaultOrder.filter((key) => key !== priority)];
          current = 0;
          setMeta();
          transition(renderQuestion);
        }));
      };

      const optionCard = (option: Option) => {
        const selected = answers[order[current]] === option.id;
        const media = option.img
          ? `<img src="${option.img}" alt="${option.title}" loading="lazy" decoding="async" />`
          : `<span class="v2-any-mark" aria-hidden="true">✦</span>`;
        return `<button type="button" class="v2-choice ${selected ? "is-selected" : ""} ${option.img ? "" : "is-any-choice"}" data-v2-choice="${option.id}">${option.img ? `<span class="v2-choice-media">${media}<i aria-hidden="true">✓</i></span>` : ""}<span class="v2-choice-copy"><strong>${option.title}</strong><span>${option.copy}</span><small>${option.sub}</small></span></button>`;
      };

      const renderQuestion = () => {
        root.dataset.stage = String(current + 1);
        const key = order[current];
        const question = questions[key];
        setMeta(question.title, `${current + 1} / 4`);
        let options = question.options.filter((option) => !(current === 0 && option.id === "any"));
        if (key === "shape") {
          options = options.filter((option) => option.id !== "any");
          if (priority !== "shape") options = options.filter((option) => availableShapeIds().includes(option.id));
        }
        stage.innerHTML = `<div class="v2-content"><p class="v2-kicker">Question ${current + 1} of 4${current === 0 ? " · Your top priority" : ""}</p><h4 tabindex="-1">${question.question}</h4><p class="v2-helper">${question.helper}</p><div class="v2-choice-grid" data-count="${options.length}">${options.map(optionCard).join("")}</div></div>`;
        stage.querySelectorAll<HTMLButtonElement>("[data-v2-choice]").forEach((button) => button.addEventListener("click", () => {
          answers[key] = button.dataset.v2Choice!;
          stage.querySelectorAll(".v2-choice").forEach((card) => card.classList.remove("is-selected"));
          button.classList.add("is-selected");
          window.setTimeout(() => {
            if (current < 3) { current += 1; transition(renderQuestion); }
            else transition(renderResults);
          }, reducedMotion.matches ? 0 : 280);
        }));
      };

      const actualAttributeLabel = (product: Product, key: QuestionKey) => {
        if (key === "shape") return product.shape === "blade" ? "Blade" : product.shape === "wide" ? "Wide Blade / Compact Mallet" : "Mallet";
        if (key === "alignment") return product.alignment === "ball" ? "2-Ball / ½ Ball" : product.alignment === "versa" ? "Versa / High Contrast" : "Classic";
        if (key === "stroke") return product.stroke === "zero" ? "Zero Torque" : product.stroke === "arc" ? "More Arc / Toe Hang" : "Minimal Arc / Face Balanced";
        if (product.face === "roll") return "Microhinge Insert";
        if (product.face === "milled") return familyInfo[product.family]?.tag || "Milled / Metal Face";
        return familyInfo[product.family]?.tag || "Urethane Insert";
      };
      const resultRow = (product: Product, key: QuestionKey, index: number) => {
        const any = answers[key] === "any";
        const match = any || product[key] === answers[key];
        return `<li><span><small>${categoryLabel(key)}${index === 0 ? " · Priority" : ""}</small><strong>${actualAttributeLabel(product, key)}</strong></span><i class="${any ? "is-any" : match ? "is-match" : ""}">${any ? "Any" : match ? "Match" : "Different"}</i></li>`;
      };
      const resultCard = (product: Product, index: number) => {
        const technology = familyInfo[product.family] || { tag: "Odyssey Technology", copy: "This model matches the fitting preferences selected in the tool." };
        const productName = product.name.replace(" Putter", "");
        const technologyLabel = low(product.name).includes("cruiser") && !low(technology.tag).includes("cruiser")
          ? `${technology.tag} + Cruiser`
          : technology.tag;
        return `<article class="v2-result-card"><div class="v2-result-media"><img class="v2-result-primary" src="${product.image}" alt="${product.name}, primary product view" loading="lazy" decoding="async" /><img class="v2-result-alternate" src="${product.alternateImage}" alt="${product.name}, sole view" loading="lazy" decoding="async" /><span>#${index + 1} · ${resultScore(product)}% fit</span></div><div class="v2-result-copy"><p class="v2-result-technology">${technologyLabel}</p><div class="v2-result-title"><h5><a href="${product.url}" target="_blank" rel="noopener noreferrer" aria-label="${productName}, view on Callaway in a new tab"><span class="v2-product-name">${productName}</span><span class="v2-product-link-arrow" aria-hidden="true">↗</span></a></h5><details class="v2-product-info"><summary aria-label="More about ${technology.tag}"><span aria-hidden="true">i</span></summary><p>${technology.copy}</p></details></div><ul>${order.map((key, orderIndex) => resultRow(product, key, orderIndex)).join("")}</ul></div></article>`;
      };
      const resultFilters = () => order.map((key, index) => `<label><span>${index === 0 ? "★ " : ""}${categoryLabel(key)}</span><select data-v2-filter="${key}">${questions[key].options.filter((option) => !(index === 0 && option.id === "any") && !(key === "shape" && option.id === "any")).map((option) => `<option value="${option.id}" ${answers[key] === option.id ? "selected" : ""}>${option.title}</option>`).join("")}</select></label>`).join("");

      const renderResults = () => {
        current = 4;
        root.dataset.stage = "results";
        setMeta("Your results", "Complete");
        const ranked = rankedProducts();
        const perPage = 4;
        const pages = Math.max(1, Math.ceil(ranked.length / perPage));
        resultPage = Math.min(resultPage, pages - 1);
        const subset = ranked.slice(resultPage * perPage, resultPage * perPage + perPage);
        root.dataset.resultView = resultImageMode;
        stage.innerHTML = `<div class="v2-results"><header class="v2-results-head"><h4 tabindex="-1">Your recommendations</h4><button class="v2-image-toggle" type="button" role="switch" data-v2-image-toggle aria-checked="${resultImageMode === "sole"}" aria-label="Show sole views"><span class="v2-toggle-track" aria-hidden="true"><i></i></span><span>Sole views</span></button></header><div class="v2-result-filters">${resultFilters()}</div><div class="v2-result-carousel"><div class="v2-result-grid">${subset.map((product, index) => resultCard(product, resultPage * perPage + index)).join("")}</div><button class="v2-result-arrow is-previous" type="button" data-v2-prev ${resultPage === 0 ? "disabled" : ""} aria-label="Previous recommendations"><span aria-hidden="true">←</span></button><button class="v2-result-arrow is-next" type="button" data-v2-next ${resultPage >= pages - 1 ? "disabled" : ""} aria-label="Next recommendations"><span aria-hidden="true">→</span></button></div><div class="v2-result-dots" role="group" aria-label="Recommendation pages">${Array.from({ length: pages }, (_, index) => `<button type="button" data-v2-page="${index}" class="${index === resultPage ? "is-active" : ""}" aria-label="Show recommendation page ${index + 1}" aria-current="${index === resultPage ? "true" : "false"}"></button>`).join("")}</div></div>`;
        stage.querySelector("[data-v2-image-toggle]")?.addEventListener("click", () => {
          resultImageMode = resultImageMode === "top" ? "sole" : "top";
          renderResults();
        });
        stage.querySelectorAll<HTMLImageElement>(".v2-result-alternate").forEach((image) => image.addEventListener("error", () => image.closest(".v2-result-card")?.classList.add("has-no-alternate"), { once: true }));
        stage.querySelector("[data-v2-prev]")?.addEventListener("click", () => { resultPage -= 1; transition(renderResults); });
        stage.querySelector("[data-v2-next]")?.addEventListener("click", () => { resultPage += 1; transition(renderResults); });
        stage.querySelectorAll<HTMLButtonElement>("[data-v2-page]").forEach((button) => button.addEventListener("click", () => { resultPage = Number(button.dataset.v2Page); transition(renderResults); }));
        stage.querySelectorAll<HTMLSelectElement>("[data-v2-filter]").forEach((select) => select.addEventListener("change", () => {
          answers[select.dataset.v2Filter as QuestionKey] = select.value;
          resultPage = 0;
          renderResults();
        }));
      };

      const reset = () => {
        defaultOrder.forEach((key) => { answers[key] = null; });
        order = [];
        priority = "shape";
        resultPage = 0;
        resultImageMode = "top";
        transition(renderIntro);
      };

      const goBack = () => {
        if (animating || current < 0 || !order.length) return;
        if (current === 0) transition(renderIntro);
        else {
          current = Math.min(current - 1, 3);
          transition(renderQuestion);
        }
      };

      resetAll.addEventListener("click", reset);
      backAll.addEventListener("click", goBack);
      renderIntro();
      selectorV2Cleanups.set(root, () => {
        resetAll.removeEventListener("click", reset);
        backAll.removeEventListener("click", goBack);
        root.removeAttribute("data-v2-ready");
      });
    });
  }

  initializePutterSelectorV2();
  document.addEventListener("astro:page-load", initializePutterSelectorV2);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-putter-v2]").forEach((root) => selectorV2Cleanups.get(root)?.());
  });
</script>

