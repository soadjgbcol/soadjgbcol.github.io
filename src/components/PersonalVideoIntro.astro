---
import previewVideo from "../assets/home/video/julian-introduction-preview.mp4?url";
import previewPoster from "../assets/home/video/julian-introduction-poster.jpg";
---

<section id="beyond-the-title" class="personal-intro" aria-labelledby="personal-intro-heading" data-personal-intro>
  <p class="personal-section-marker">01 / How I Work</p>
  <div class="container personal-intro-grid">
    <div class="personal-video" aria-label="Personal introduction video preview" data-preview-frame>
      <video
        class="preview-video"
        src={previewVideo}
        poster={previewPoster.src}
        width="540"
        height="960"
        muted
        playsinline
        preload="metadata"
        aria-label="Preview of Julian’s personal introduction"
        data-preview-video
      ></video>
      <button class="video-open" type="button" aria-pressed="false" data-video-play>
        <span class="play-icon" aria-hidden="true">▶</span>
        <span data-video-label>Play with sound</span>
      </button>
    </div>

    <div class="personal-copy">
      <p class="eyebrow">Beyond the title</p>
      <h2 id="personal-intro-heading">I move between strategy, design, and execution.</h2>
      <div class="personal-summary">
        <p>I lead product design and strategy while staying hands-on: designing and testing customer experiences, prototyping new ideas, and building internal tools and AI workflows that remove friction from how teams work.</p>
        <p>Along the way, I’ve grown a <strong>design team from 1 to 4</strong>, scaled experimentation to <strong>40+ tests a year across 4 brands</strong>, and built <strong>AI-powered tools that made asset delivery ~4× faster</strong>.</p>
      </div>
      <ul class="responsibility-list" aria-label="Julian’s areas of expertise">
        <li>AI product strategy</li>
        <li>UX &amp; systems design</li>
        <li>Experimentation &amp; optimization</li>
        <li>Design leadership</li>
        <li>AI-powered workflows</li>
        <li>Team enablement</li>
      </ul>
    </div>
  </div>

</section>

<script>
  const personalIntroCleanups = new WeakMap<HTMLElement, () => void>();

  function initializePersonalIntros() {
    document.querySelectorAll<HTMLElement>("[data-personal-intro]:not([data-intro-ready])").forEach((section) => {
      section.dataset.introReady = "true";
      const playButton = section.querySelector<HTMLButtonElement>("[data-video-play]");
      const playLabel = section.querySelector<HTMLElement>("[data-video-label]");
      const preview = section.querySelector<HTMLVideoElement>("[data-preview-video]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      let sectionEngaged = false;
      let previewVisible = true;
      let manualMode = false;
      let manualPlayRequested = false;
      if (!playButton || !playLabel || !preview) return;

      const updatePreview = async () => {
        const shouldPreview = !manualMode && sectionEngaged && finePointer.matches && !reducedMotion.matches;
        const shouldPlay = previewVisible && (manualPlayRequested || shouldPreview);
        if (!shouldPlay) {
          preview.pause();
          return;
        }
        preview.muted = !manualMode;
        try { await preview.play(); } catch {
          preview.muted = true;
          manualPlayRequested = false;
          updateButton();
        }
      };

      const updateButton = () => {
        const playingManually = manualMode && manualPlayRequested && !preview.paused;
        section.toggleAttribute("data-manual-video", manualMode);
        playButton.setAttribute("aria-pressed", String(playingManually));
        playLabel.textContent = manualMode ? (playingManually ? "Pause" : "Play") : "Play with sound";
        const icon = playButton.querySelector<HTMLElement>(".play-icon");
        if (icon) icon.textContent = playingManually ? "Ⅱ" : "▶";
      };
      const toggleManualPlayback = async () => {
        if (!manualMode) {
          manualMode = true;
          manualPlayRequested = true;
          preview.currentTime = 0;
          preview.muted = false;
          updateButton();
          await updatePreview();
          updateButton();
          return;
        }

        if (!preview.paused) {
          manualPlayRequested = false;
          preview.pause();
          updateButton();
          return;
        }

        manualPlayRequested = true;
        preview.muted = false;
        await updatePreview();
        updateButton();
      };
      const engage = () => { sectionEngaged = true; void updatePreview(); };
      const disengage = () => { sectionEngaged = false; if (!manualMode) void updatePreview(); };
      const respondToMotion = () => void updatePreview();
      const observer = new IntersectionObserver(([entry]) => {
        previewVisible = entry.isIntersecting;
        if (!previewVisible && manualMode) {
          manualPlayRequested = false;
          preview.pause();
          updateButton();
        }
        void updatePreview();
      }, { threshold: 0.2 });

      const handleEnded = () => {
        manualPlayRequested = false;
        updateButton();
      };

      playButton.addEventListener("click", toggleManualPlayback);
      preview.addEventListener("play", updateButton);
      preview.addEventListener("pause", updateButton);
      preview.addEventListener("ended", handleEnded);
      section.addEventListener("pointerenter", engage);
      section.addEventListener("pointerleave", disengage);
      section.addEventListener("focusin", engage);
      section.addEventListener("focusout", disengage);
      reducedMotion.addEventListener("change", respondToMotion);
      observer.observe(preview);
      preview.pause();
      updateButton();

      personalIntroCleanups.set(section, () => {
        playButton.removeEventListener("click", toggleManualPlayback);
        preview.removeEventListener("play", updateButton);
        preview.removeEventListener("pause", updateButton);
        preview.removeEventListener("ended", handleEnded);
        section.removeEventListener("pointerenter", engage);
        section.removeEventListener("pointerleave", disengage);
        section.removeEventListener("focusin", engage);
        section.removeEventListener("focusout", disengage);
        reducedMotion.removeEventListener("change", respondToMotion);
        observer.disconnect();
        preview.pause();
        section.removeAttribute("data-intro-ready");
      });
    });
  }

  initializePersonalIntros();
  document.addEventListener("astro:page-load", initializePersonalIntros);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-personal-intro]").forEach((section) => {
      personalIntroCleanups.get(section)?.();
      personalIntroCleanups.delete(section);
    });
  });
</script>

<style>
  .personal-intro { position: relative; padding-block: clamp(5rem, 8vw, 8rem); border-bottom: 1px solid var(--color-border); background: #fff; color: var(--color-text); }
  .personal-section-marker { position: absolute; top: 1.25rem; left: max(var(--space-5), calc((100vw - 78rem) / 2)); margin: 0; color: color-mix(in srgb, var(--color-text) 50%, transparent); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  .personal-intro-grid { display: grid; grid-template-columns: minmax(15rem, 0.62fr) minmax(18rem, 1.38fr); align-items: center; justify-items: center; gap: clamp(2rem, 7vw, 7rem); }
  .personal-video { display: grid; position: relative; width: min(100%, 25rem); aspect-ratio: 9 / 16; justify-self: center; overflow: hidden; place-items: center; border: 1px solid var(--color-border-strong); border-radius: 0.45rem; background: #080a09; }
  .preview-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .video-open { display: flex; position: relative; z-index: 2; min-height: 3rem; align-items: center; padding: 0.5rem 1rem 0.5rem 0.55rem; border: 1px solid rgb(255 255 255 / 0.55); border-radius: 999px; background: rgb(8 10 9 / 0.78); color: #fff; font: inherit; font-size: 0.82rem; font-weight: 700; gap: 0.7rem; opacity: 0.92; transition: opacity 180ms ease, background-color 180ms ease, inset 220ms ease, transform 220ms ease; cursor: pointer; }
  [data-manual-video] .video-open { position: absolute; right: 0.75rem; bottom: 0.75rem; min-height: 2.65rem; padding: 0.35rem 0.75rem 0.35rem 0.4rem; transform: none; }
  .personal-video:hover .video-open, .personal-video:focus-within .video-open { opacity: 1; }
  .video-open:hover { background: #1c211e; }
  .video-open:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .play-icon { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; background: #f4f3ef; color: #111310; font-size: 0.7rem; }
  .personal-copy { display: grid; justify-items: center; text-align: center; }
  .personal-copy .eyebrow { color: var(--color-accent); }
  .personal-copy h2 { max-width: 25ch; margin-block: var(--space-3) var(--space-5); color: var(--color-text); font-size: clamp(1.75rem, 2.6vw, 2.75rem); letter-spacing: -0.04em; line-height: 1.08; }
  .personal-copy p { max-width: 38rem; color: var(--color-text-muted); font-size: var(--step--1); line-height: 1.65; }
  .personal-copy .personal-summary { max-width: 43rem; color: var(--color-text); font-size: var(--step-0); }
  .personal-copy .personal-summary p { max-width: inherit; margin: 0; color: var(--color-text); font-size: inherit; }
  .personal-copy .personal-summary p + p { margin-top: var(--space-3); }
  .personal-copy .personal-summary strong { font-weight: 750; }
  .responsibility-list { display: flex; max-width: 42rem; flex-wrap: wrap; justify-content: center; margin: var(--space-5) 0 0; padding: 0; gap: var(--space-2); list-style: none; }
  .responsibility-list li { display: inline-flex; min-height: 2.5rem; align-items: center; padding: 0.45rem 0.75rem; border: 1px solid var(--color-border-strong); border-radius: 999px; background: #fff; color: var(--color-text); font-size: 0.76rem; font-weight: 700; gap: 0.5rem; }
  .responsibility-list li::before { display: grid; width: 1.15rem; height: 1.15rem; flex: 0 0 auto; place-items: center; border: 1px solid var(--color-accent); border-radius: 50%; color: var(--color-accent); content: "✓"; font-family: var(--font-mono); font-size: 0.62rem; line-height: 1; }
  @media (max-width: 54rem) {
    .personal-intro-grid { grid-template-columns: 1fr; }
    .personal-copy { grid-row: 1; }
    .personal-copy h2 { max-width: 25ch; }
    .personal-video { width: min(100%, 22rem); max-height: 72svh; }
  }
  @media (hover: none), (pointer: coarse) { .video-open { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .video-open { transition: none; }
  }
</style>
