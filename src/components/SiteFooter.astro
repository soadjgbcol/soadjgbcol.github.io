---
import julianLogo from "../../../assets/shared/julian-logo.png";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-brand" href="/" aria-label="Julian Galindo, home">
      <img src={julianLogo.src} width={julianLogo.width} height={julianLogo.height} alt="" />
      <span><strong>Julian Galindo</strong><small>One thoughtful pixel at a time.</small></span>
    </a>
    <nav aria-label="Footer navigation">
      <a href="/work/">Work</a>
      <a href="/about/">About</a>
      <a href="https://www.linkedin.com/in/julian-galindo-designs/" target="_blank" rel="noreferrer">LinkedIn</a>
    </nav>
    <small class="copyright">© {year} · Designed and built by Julian.</small>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border-strong); background: color-mix(in srgb, var(--color-text) 96%, var(--color-accent)); color: var(--color-surface); }
  .footer-inner { display: grid; min-height: 6.5rem; grid-template-columns: minmax(13rem, 1fr) auto auto; align-items: center; gap: var(--space-6); padding-block: var(--space-4); }
  .footer-brand { display: inline-flex; width: fit-content; align-items: center; gap: var(--space-3); color: inherit; text-decoration: none; }
  .footer-brand img { width: 2rem; height: 2rem; border-radius: 0.2rem; filter: brightness(0) invert(1); }
  .footer-brand span { display: grid; }
  .footer-brand strong { font-size: var(--step--1); }
  .footer-brand small, .copyright { color: #bdbdb4; font-size: 0.7rem; }
  nav { display: flex; gap: var(--space-4); }
  nav a { min-height: 2.75rem; display: inline-flex; align-items: center; color: #e7e7e0; font-size: var(--step--1); text-decoration: none; }
  nav a:hover { color: #fff; }
  .copyright { text-align: right; }
  @media (max-width: 46rem) {
    .footer-inner { grid-template-columns: 1fr auto; gap: var(--space-3); }
    .copyright { grid-column: 1 / -1; text-align: left; }
  }
  @media (max-width: 28rem) {
    .footer-inner { grid-template-columns: 1fr; }
    nav { gap: var(--space-5); }
  }
</style>
