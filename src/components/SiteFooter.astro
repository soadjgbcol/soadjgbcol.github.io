---
const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-intro">
      <div class="footer-message">
        <p>Let’s make it simpler.</p>
        <h2>Have a complicated problem that should probably be easier?</h2>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      {!isHome && <a class="footer-home" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-9Z" /></svg><span>Home</span></a>}
      <a href="/#featured-work">Work</a>
      <a href="/about/">About</a>
      <a href="mailto:juliangalindo11@gmail.com">
        Email me
      </a>
      <a href="https://www.linkedin.com/in/julian-galindo-designs/" target="_blank" rel="noreferrer">
        LinkedIn
      </a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <small>© {year} Julian Galindo</small>
    <small>Austin, TX</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background:
      radial-gradient(circle at 4% 18%, rgb(255 255 255 / 0.1), transparent 19rem),
      radial-gradient(circle at 94% 92%, rgb(255 255 255 / 0.065), transparent 24rem),
      #080a09;
    color: #f4f3ef;
  }

  .footer-main {
    display: grid;
    position: relative;
    isolation: isolate;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .footer-intro {
    display: flex;
    position: relative;
    z-index: 1;
    min-width: 0;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .footer-message p {
    margin: 0 0 0.25rem;
    color: rgb(244 243 239 / 0.58);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-message h2 {
    max-width: 30ch;
    margin: 0;
    color: #f4f3ef;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .footer-links {
    display: flex;
    position: relative;
    z-index: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.8rem;
    border-radius: var(--radius-sm);
    color: rgb(244 243 239 / 0.76);
    font-size: var(--step--1);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .footer-home { gap: 0.4rem; }
  .footer-home svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    background: rgb(255 255 255 / 0.09);
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    gap: var(--space-4);
  }

  .footer-bottom small {
    color: rgb(244 243 239 / 0.48);
    font-size: 0.7rem;
  }

  @media (max-width: 46rem) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .footer-links { justify-content: flex-start; }
  }

  @media (max-width: 28rem) {
    .footer-intro { align-items: flex-start; }
    .footer-links { width: 100%; flex-wrap: wrap; }
  }

</style>
