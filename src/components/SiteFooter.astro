---
import julianLogoBase from "../assets/legacy/JG Logobg.png";
import julianLogoOrbit from "../assets/legacy/JG Logo.png";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-intro">
      <a class="footer-logo" href="/" aria-label="Julian Galindo, home">
        <span class="footer-logo-mark" aria-hidden="true">
          <img class="footer-logo-base" src={julianLogoBase.src} width={julianLogoBase.width} height={julianLogoBase.height} alt="" />
          <img class="footer-logo-orbit" src={julianLogoOrbit.src} width={julianLogoOrbit.width} height={julianLogoOrbit.height} alt="" />
        </span>
      </a>

      <div class="footer-message">
        <p>Let’s make it simpler.</p>
        <h2>Have a complicated problem that should probably be easier?</h2>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/work/">Work</a>
      <a href="/about/">About</a>
      <a class="footer-contact" href="https://www.linkedin.com/in/julian-galindo-designs/" target="_blank" rel="noreferrer">
        Contact me <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <small>© {year} Julian Galindo</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background: #080a09;
    color: #f4f3ef;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .footer-intro {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .footer-logo {
    display: inline-grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
  }

  .footer-logo-mark {
    display: block;
    position: relative;
    width: 3.75rem;
    height: 3.75rem;
  }

  .footer-logo-mark img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .footer-logo-orbit { animation: footer-logo-orbit 25s linear infinite; }

  .footer-message p {
    margin: 0 0 0.25rem;
    color: rgb(244 243 239 / 0.58);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-message h2 {
    max-width: 30ch;
    margin: 0;
    color: #f4f3ef;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.8rem;
    border-radius: var(--radius-sm);
    color: rgb(244 243 239 / 0.76);
    font-size: var(--step--1);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    background: rgb(255 255 255 / 0.09);
    color: #fff;
  }

  .footer-links .footer-contact {
    margin-left: 0.35rem;
    padding-inline: 1rem;
    border: 1px solid rgb(255 255 255 / 0.34);
    color: #fff;
    font-weight: 750;
    gap: 0.4rem;
  }

  .footer-bottom {
    padding-block: 0.9rem 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer-bottom small {
    color: rgb(244 243 239 / 0.48);
    font-size: 0.7rem;
  }

  @keyframes footer-logo-orbit {
    to { transform: rotate(-360deg); }
  }

  @media (max-width: 46rem) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .footer-links { justify-content: flex-start; }
  }

  @media (max-width: 28rem) {
    .footer-intro { align-items: flex-start; }
    .footer-logo { width: 3.25rem; height: 3.25rem; }
    .footer-logo-mark { width: 3rem; height: 3rem; }
    .footer-links { width: 100%; flex-wrap: wrap; }
    .footer-links .footer-contact { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-logo-orbit { animation: none; }
  }
</style>
