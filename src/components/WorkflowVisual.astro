  <div class="complexity-cluster" aria-hidden="true">
    <svg viewBox="0 0 280 220" preserveAspectRatio="xMidYMid meet">
      <g class="messy-paths" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M22 47 C72 18 78 112 135 67 S223 27 258 78" />
        <path d="M31 169 C68 108 112 207 159 145 S222 101 258 164" />
        <path d="M46 110 C94 61 112 161 171 99 S223 69 251 113" />
        <path d="M76 26 C116 78 83 133 132 190" />
        <path d="M206 29 C174 76 228 126 191 190" />
      </g>
      <g class="messy-nodes">
        <circle cx="22" cy="47" r="5" /><circle cx="31" cy="169" r="5" />
