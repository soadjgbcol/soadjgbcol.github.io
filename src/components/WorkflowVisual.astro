    .process-route::before { transform: scaleX(1); }
    .process-route li { opacity: 1; transform: none; }
    .process-signal { display: none; }
  }

  @media (max-width: 34rem) and (prefers-reduced-motion: reduce) {
    .process-route::before { transform: scaleY(1); }
  }
</style>
