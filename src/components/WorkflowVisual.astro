        <circle cx="132" cy="190" r="5" /><circle cx="206" cy="29" r="5" />
        <circle cx="258" cy="78" r="5" /><circle cx="258" cy="164" r="5" />
        <circle cx="171" cy="99" r="5" /><circle cx="191" cy="190" r="5" />
      </g>
      <circle class="complexity-pulse" cx="140" cy="110" r="31" />
