      </span>
      <strong>Improve</strong>
      <small>Carry learning forward</small>
    </li>
  </ol>
</div>

<script>
  const workflowObservers = new WeakMap<HTMLElement, IntersectionObserver>();

  function initializeWorkflowVisuals() {
    document.querySelectorAll<HTMLElement>("[data-workflow-visual]:not([data-workflow-ready])").forEach((visual) => {
      visual.dataset.workflowReady = "true";
      const observer = new IntersectionObserver(([entry]) => {
        visual.classList.toggle("is-visible", entry.isIntersecting);
      }, { threshold: 0.28 });
      observer.observe(visual);
      workflowObservers.set(visual, observer);
    });
  }

  initializeWorkflowVisuals();
  document.addEventListener("astro:page-load", initializeWorkflowVisuals);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-workflow-visual]").forEach((visual) => {
      workflowObservers.get(visual)?.disconnect();
      workflowObservers.delete(visual);
      visual.removeAttribute("data-workflow-ready");
    });
  });
</script>

<style>
  .workflow-visual {
    display: grid;
    position: relative;
    grid-template-columns: minmax(14rem, 0.68fr) minmax(6rem, 0.24fr) minmax(0, 1.7fr);
    min-height: 24rem;
    align-items: center;
    padding: clamp(var(--space-5), 4vw, var(--space-8));
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--color-accent) 4%, transparent), transparent 42%),
      var(--color-surface-raised);
    gap: var(--space-5);
  }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .complexity-cluster { position: relative; min-width: 0; }
  .complexity-cluster svg { display: block; width: 100%; color: color-mix(in srgb, var(--color-text-muted) 75%, transparent); }
  .messy-paths path { stroke-dasharray: 10 7; stroke-dashoffset: 34; opacity: 0.64; }
  .messy-nodes circle { fill: var(--color-surface-raised); stroke: var(--color-text-muted); stroke-width: 1.2; transform-box: fill-box; transform-origin: center; }
  .complexity-pulse { fill: color-mix(in srgb, var(--color-accent) 8%, transparent); stroke: color-mix(in srgb, var(--color-accent) 46%, transparent); stroke-width: 1; transform-box: fill-box; transform-origin: center; }
  .cluster-label { position: absolute; inset: 50% auto auto 50%; display: grid; width: 9.5rem; text-align: center; transform: translate(-50%, -50%); }
  .cluster-label span, .convergence span, .step-number { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.07em; text-transform: uppercase; }
  .cluster-label strong { margin-top: var(--space-1); font-size: 0.76rem; line-height: 1.25; }

  .convergence { display: grid; gap: var(--space-3); color: var(--color-accent); }
  .convergence svg { width: 100%; height: 5rem; overflow: visible; }
  .converge-line { fill: none; stroke: currentColor; stroke-width: 1; stroke-dasharray: 150; stroke-dashoffset: 150; }
  .converge-node { fill: var(--color-surface-raised); stroke: currentColor; stroke-width: 1.5; }
  .convergence span { max-width: 8rem; color: var(--color-text-muted); line-height: 1.45; }

  .process-route {
    display: grid;
    position: relative;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    --route-center: 4.5rem;
  }

  .process-route::before {
    position: absolute;
    top: var(--route-center);
    right: 8%;
    left: 8%;
    height: 1px;
    background: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
    content: "";
    transform: scaleX(0);
    transform-origin: left;
  }

  .process-route li {
    display: grid;
    position: relative;
    min-width: 0;
    padding-inline: var(--space-2);
    justify-items: center;
    text-align: center;
    opacity: 0;
    transform: translateY(1rem);
  }

  .step-number { margin-bottom: var(--space-3); }
  .step-icon {
    display: grid;
    position: relative;
    z-index: 4;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-4);
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
    border-radius: 50%;
    background: var(--color-surface-raised);
    color: var(--color-accent);
    box-shadow: 0 0 0 0.4rem var(--color-surface-raised);
  }

  .step-icon svg { width: 1.35rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
  .process-route strong { font-size: var(--step--1); line-height: 1.2; }
  .process-route small { max-width: 10rem; margin-top: var(--space-2); color: var(--color-text-muted); font-size: 0.72rem; line-height: 1.35; }

  .process-signal {
    position: absolute;
    z-index: 2;
    top: calc(var(--route-center) - 0.275rem);
    left: 8%;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--color-surface-raised);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
    opacity: 0;
  }

  .is-visible .messy-paths path { animation: complexity-flow 4.8s linear infinite; }
  .is-visible .messy-paths path:nth-child(even) { animation-direction: reverse; animation-duration: 5.8s; }
  .is-visible .messy-nodes circle { animation: node-drift 3.6s ease-in-out infinite alternate; }
  .is-visible .messy-nodes circle:nth-child(3n) { animation-delay: -1.4s; }
  .is-visible .complexity-pulse { animation: cluster-pulse 3.2s ease-in-out infinite; }
  .is-visible .converge-line { animation: converge-draw 900ms ease-out forwards; }
  .is-visible .converge-line:nth-child(2) { animation-delay: 160ms; }
  .is-visible .converge-line:nth-child(3) { animation-delay: 320ms; }
  .is-visible .process-route::before { animation: route-draw 900ms 600ms ease-out forwards; }
  .is-visible .process-route li { animation: step-arrive 560ms calc(720ms + var(--step-index) * 120ms) ease-out forwards; }
  .is-visible .process-signal { animation: signal-travel 6s 1.8s linear infinite; }
  .is-visible .step-icon { animation: icon-signal 6s calc(1.8s + var(--step-index) * 1.2s) linear infinite; }

  @keyframes complexity-flow { to { stroke-dashoffset: -34; } }
  @keyframes node-drift { from { transform: translate(-1px, -2px); } to { transform: translate(2px, 2px); } }
  @keyframes cluster-pulse { 0%, 100% { opacity: 0.5; transform: scale(0.92); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes converge-draw { to { stroke-dashoffset: 0; } }
  @keyframes route-draw { to { transform: scaleX(1); } }
  @keyframes step-arrive { to { opacity: 1; transform: translateY(0); } }
  @keyframes signal-travel { 0% { left: 8%; opacity: 0; } 5% { opacity: 1; } 85% { left: calc(92% - 0.55rem); opacity: 1; } 92%, 100% { left: calc(92% - 0.55rem); opacity: 0; } }
  @keyframes icon-signal { 0%, 14%, 100% { border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border)); background: var(--color-surface-raised); transform: translateY(0); } 5%, 8% { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface-raised)); transform: translateY(-0.16rem); } }

  @media (max-width: 66rem) {
    .workflow-visual { grid-template-columns: minmax(12rem, 0.55fr) minmax(5rem, 0.2fr) minmax(0, 1.4fr); padding-inline: var(--space-5); }
    .process-route small { display: none; }
  }

  @media (max-width: 50rem) {
    .workflow-visual { grid-template-columns: minmax(0, 0.8fr) minmax(5rem, 0.2fr); gap: var(--space-4); }
    .process-route { grid-column: 1 / -1; margin-top: var(--space-5); }
    .complexity-cluster svg { max-height: 13rem; }
  }

  @media (max-width: 34rem) {
    .workflow-visual { grid-template-columns: 1fr; padding: var(--space-5); }
    .complexity-cluster svg { height: 9rem; }
    .convergence { justify-items: center; }
    .convergence svg { width: 5rem; height: 3.5rem; transform: rotate(90deg); }
    .convergence span { max-width: none; text-align: center; }
    .process-route { grid-column: auto; grid-template-columns: 1fr; margin-top: var(--space-3); gap: var(--space-2); }
    .process-route::before { top: 1.75rem; bottom: 1.75rem; left: 1.75rem; width: 1px; height: auto; transform: scaleY(0); transform-origin: top; }
    .process-route li { grid-template-columns: 3.5rem minmax(0, 1fr); min-height: 4rem; padding: 0; align-items: center; justify-items: start; text-align: left; column-gap: var(--space-4); }
    .step-number { display: none; }
    .step-icon { grid-row: 1 / 3; margin: 0; }
    .process-route strong { align-self: end; }
    .process-route small { display: block; align-self: start; margin-top: var(--space-1); }
    .process-signal { display: none; }
    .is-visible .process-route::before { animation-name: route-draw-mobile; }
  }

  @media (max-width: 34rem) and (max-height: 42rem) {
    .workflow-visual { padding: var(--space-4); gap: var(--space-2); }
    .complexity-cluster svg { height: 6rem; }
    .cluster-label { width: 8.5rem; }
    .cluster-label strong { font-size: 0.68rem; }
    .convergence { gap: 0; }
    .convergence svg { width: 3.75rem; height: 2.25rem; }
    .convergence span { font-size: 0.56rem; }
    .process-route { margin-top: var(--space-2); gap: var(--space-1); }
    .process-route::before { top: 1.4rem; bottom: 1.4rem; left: 1.4rem; }
    .process-route li { grid-template-columns: 2.8rem minmax(0, 1fr); min-height: 3rem; column-gap: var(--space-3); }
    .step-icon { width: 2.8rem; height: 2.8rem; }
