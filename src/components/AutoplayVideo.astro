---
interface Props {
  src: string;
  poster: string;
  label: string;
  width: number;
  height: number;
}

const { src, poster, label, width, height } = Astro.props;
---

<div class="autoplay-video" data-autoplay-video>
  <video
    src={src}
    poster={poster}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={label}
    data-video
  ></video>
  <button type="button" aria-label="Play hero interaction" aria-pressed="false" data-video-control>
    <span class="visually-hidden" data-video-label>Play hero interaction</span>
    <svg class="play-icon" aria-hidden="true" viewBox="0 0 24 24" data-video-play-icon><path d="M8 5.5v13l10-6.5z" /></svg>
    <svg class="pause-icon" aria-hidden="true" viewBox="0 0 24 24" data-video-pause-icon hidden><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-autoplay-video]:not([data-video-bound])").forEach((player) => {
    player.dataset.videoBound = "true";
    const video = player.querySelector<HTMLVideoElement>("[data-video]");
    const control = player.querySelector<HTMLButtonElement>("[data-video-control]");
    const label = player.querySelector<HTMLElement>("[data-video-label]");
    const playIcon = player.querySelector<SVGElement>("[data-video-play-icon]");
    const pauseIcon = player.querySelector<SVGElement>("[data-video-pause-icon]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let userPaused = false;

    if (!video || !control || !label || !playIcon || !pauseIcon) return;

    const updateControl = (playing: boolean) => {
      control.setAttribute("aria-pressed", String(playing));
      control.setAttribute("aria-label", playing ? "Pause hero interaction" : "Play hero interaction");
      label.textContent = playing ? "Pause hero interaction" : "Play hero interaction";
      playIcon.toggleAttribute("hidden", playing);
      pauseIcon.toggleAttribute("hidden", !playing);
    };

    const play = async () => {
      if (reducedMotion.matches || userPaused) return;
      try {
        await video.play();
        updateControl(true);
      } catch {
        updateControl(false);
      }
    };

    const pause = () => {
      video.pause();
      updateControl(false);
    };

    control.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        void play();
      } else {
        userPaused = true;
        pause();
      }
    });

    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        userPaused = false;
        pause();
        video.currentTime = 0;
      } else {
        void play();
      }
    });

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) void play();
      else pause();
    }, { threshold: 0.2 });

    observer.observe(player);
    updateControl(false);
  });
</script>

<style>
  .autoplay-video { display: grid; position: relative; width: 100%; max-height: min(80vh, 44rem); place-items: center; background: #e7e9e5; }
  video { display: block; width: auto; max-width: 100%; height: auto; max-height: min(80vh, 44rem); object-fit: contain; }
  button {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.68);
    border-radius: 50%;
    background: rgb(15 18 16 / 0.82);
    color: #fff;
    cursor: pointer;
  }
  button:hover { background: #111411; }
  button:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  button svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  button svg[hidden] { display: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) {
    button { display: none; }
    video { background: #e7e9e5; }
  }
</style>
